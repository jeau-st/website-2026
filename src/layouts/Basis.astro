---
import { Font } from "astro:assets";
import Kop from "../components/Kop.astro";
import Voet from "../components/Voet.astro";
import { analyticsToken, bedrijf } from "../data/site";
import "../styles/global.css";

interface Props {
  titel: string;
  beschrijving: string;
}

const { titel, beschrijving } = Astro.props;

const canoniek = new URL(Astro.url.pathname, Astro.site);
const ogAfbeelding = new URL("/og.png", Astro.site);

const schema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: bedrijf.naam,
  description: beschrijving,
  url: Astro.site?.toString(),
  email: bedrijf.email,
  telephone: bedrijf.telefoon,
  founder: { "@type": "Person", name: bedrijf.persoon },
  address: {
    "@type": "PostalAddress",
    addressLocality: bedrijf.plaats,
    addressCountry: "NL",
  },
  areaServed: { "@type": "Country", name: "Nederland" },
  sameAs: [bedrijf.linkedin],
  identifier: { "@type": "PropertyValue", name: "KvK", value: bedrijf.kvk },
};
---

<!doctype html>
<html lang="nl" data-thema="licht">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#e8e1cc" id="thema-kleur" />

    <script is:inline>
      /* Voor het schilderen, anders flitst de pagina licht op bij donker. */
      try {
        if (localStorage.getItem("thema") === "donker") {
          document.documentElement.dataset.thema = "donker";
          document.getElementById("thema-kleur")?.setAttribute("content", "#102019");
        }
      } catch (e) {
        /* privemodus: dan gewoon licht */
      }
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-ibm-plex-mono" />

    <title>{titel}</title>
    <meta name="description" content={beschrijving} />
    <link rel="canonical" href={canoniek} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:site_name" content={bedrijf.naam} />
    <meta property="og:title" content={titel} />
    <meta property="og:description" content={beschrijving} />
    <meta property="og:url" content={canoniek} />
    <meta property="og:image" content={ogAfbeelding} />
    <meta name="twitter:card" content="summary_large_image" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(schema)}
      is:inline
    />
  </head>
  <body class="bg-bg font-body text-tekst antialiased">
    <a
      href="#inhoud"
      class="fixed left-4 top-4 z-20 inline-flex min-h-11 -translate-y-24 items-center bg-accent px-4 py-2 font-semibold text-op-accent focus:translate-y-0"
    >
      Naar de inhoud
    </a>
    <Kop />
    <main id="inhoud">
      <slot />
    </main>
    <Voet />

    {
      /* Cookieloos, dus geen melding nodig. Laadt alleen met een token. */
      analyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${analyticsToken}"}`}
        />
      )
    }
  </body>
</html>
