---
import { Font } from "astro:assets";
import Kop from "../components/Kop.astro";
import Voet from "../components/Voet.astro";
import ZwevendeKnop from "../components/ZwevendeKnop.astro";
import { analyticsToken, bedrijf } from "../data/site";
import "../styles/global.css";

interface Props {
  titel: string;
  beschrijving: string;
  /**
   * Extra schema.org-blok voor deze pagina, bijvoorbeeld een FAQPage.
   * Een pagina mag er meer dan één hebben: een dienstpagina heeft een
   * Service en een BreadcrumbList.
   */
  extraSchema?: Record<string, unknown> | Record<string, unknown>[];
}

const { titel, beschrijving, extraSchema } = Astro.props;

const canoniek = new URL(Astro.url.pathname, Astro.site);
const ogAfbeelding = new URL("/og.png", Astro.site);

/**
 * ProfessionalService is een soort LocalBusiness, dus adres en plaats
 * tellen mee voor zoekopdrachten met een stad erin. De @id maakt het op
 * elke pagina hetzelfde bedrijf en niet elke keer een nieuw.
 */
const bedrijfSchema = {
  "@type": "ProfessionalService",
  "@id": `${Astro.site}#bedrijf`,
  name: bedrijf.naam,
  description: beschrijving,
  url: Astro.site?.toString(),
  email: bedrijf.email,
  telephone: bedrijf.telefoon,
  /* Dezelfde @id als het Person-blok op /over, zodat de oprichter en de
     persoon op die pagina één entiteit zijn en geen twee. */
  founder: {
    "@type": "Person",
    "@id": `${Astro.site}over/#joost`,
    name: bedrijf.persoon,
  },
  address: {
    "@type": "PostalAddress",
    addressLocality: bedrijf.plaats,
    addressCountry: "NL",
  },
  areaServed: [
    { "@type": "City", name: bedrijf.plaats },
    { "@type": "Country", name: "Nederland" },
  ],
  knowsAbout: [
    "Pipedrive",
    "CRM-implementatie",
    "n8n",
    "procesautomatisering",
    "systeemkoppelingen",
  ],
  sameAs: [bedrijf.linkedin],
  identifier: { "@type": "PropertyValue", name: "KvK", value: bedrijf.kvk },
};

/**
 * De site zelf als entiteit, met het bedrijf als uitgever. Dat maakt van
 * de losse pagina's één geheel voor een zoekmachine of een AI die de site
 * naloopt.
 */
const siteSchema = {
  "@type": "WebSite",
  "@id": `${Astro.site}#site`,
  name: bedrijf.naam,
  url: Astro.site?.toString(),
  inLanguage: "nl-NL",
  publisher: { "@id": `${Astro.site}#bedrijf` },
};

/* Eén graph, zodat een pagina haar eigen blokken naast het bedrijf zet. */
const eigen = extraSchema
  ? Array.isArray(extraSchema)
    ? extraSchema
    : [extraSchema]
  : [];

const schema = {
  "@context": "https://schema.org",
  "@graph": [bedrijfSchema, siteSchema, ...eigen],
};
---

<!doctype html>
<html lang="nl" data-thema="donker">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#090e11" id="thema-kleur" />

    <script is:inline>
      /* Voor het schilderen, anders flitst de pagina donker op bij licht. */
      try {
        if (localStorage.getItem("thema") === "licht") {
          document.documentElement.dataset.thema = "licht";
          document.getElementById("thema-kleur")?.setAttribute("content", "#f8fafc");
        }
      } catch (e) {
        /* privemodus: dan gewoon donker */
      }
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--font-manrope" preload />
    <Font cssVariable="--font-ibm-plex-mono" />

    <title>{titel}</title>
    <meta name="description" content={beschrijving} />
    <link rel="canonical" href={canoniek} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:site_name" content={bedrijf.naam} />
    <meta property="og:title" content={titel} />
    <meta property="og:description" content={beschrijving} />
    <meta property="og:url" content={canoniek} />
    <meta property="og:image" content={ogAfbeelding} />
    <meta name="twitter:card" content="summary_large_image" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(schema)}
      is:inline
    />
  </head>
  <body class="bg-bg font-body text-tekst antialiased">
    <a
      href="#inhoud"
      class="fixed left-4 top-4 z-40 inline-flex min-h-11 -translate-y-24 items-center rounded-klein bg-accent px-5 py-2 text-sm font-medium tracking-[0.02em] text-op-accent focus:translate-y-0"
    >
      Naar de inhoud
    </a>
    <Kop />
    <main id="inhoud">
      <slot />
    </main>
    <Voet />
    <ZwevendeKnop />

    {
      /* Cookieloos, dus geen melding nodig. Laadt alleen met een token. */
      analyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${analyticsToken}"}`}
        />
      )
    }
  </body>
</html>
