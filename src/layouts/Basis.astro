---
import { Font } from "astro:assets";
import Kop from "../components/Kop.astro";
import Voet from "../components/Voet.astro";
import ZwevendeKnop from "../components/ZwevendeKnop.astro";
import { analyticsToken, bedrijf } from "../data/site";
import { teksten } from "../data/teksten";
import { tegenhanger } from "../data/paden";
import {
  TALEN,
  ogTaal,
  taalUitPad,
  taalcode,
  type Taal,
} from "../data/taal";
import "../styles/global.css";

interface Props {
  titel: string;
  beschrijving: string;
  /**
   * Extra schema.org-blok voor deze pagina, bijvoorbeeld een FAQPage.
   * Een pagina mag er meer dan één hebben: een dienstpagina heeft een
   * Service en een BreadcrumbList.
   */
  extraSchema?: Record<string, unknown> | Record<string, unknown>[];
}

const { titel, beschrijving, extraSchema } = Astro.props;

/**
 * De taal komt uit het pad en niet uit een prop: elke pagina staat op een
 * adres dat de taal al zegt, dus een tweede bron zou er alleen van kunnen
 * afwijken. Zie src/data/taal.ts.
 */
const taal: Taal = taalUitPad(Astro.url.pathname);
const t = teksten[taal];

const canoniek = new URL(Astro.url.pathname, Astro.site);
const ogAfbeelding = new URL("/og.png", Astro.site);

/**
 * De verwijzingen naar dezelfde pagina in de andere taal. Google leest de
 * twee daarmee als een paar in plaats van als twee pagina's die op elkaar
 * lijken, en x-default wijst naar het Nederlands: dat is de taal van de
 * site, en wie geen van beide spreekt komt daar terecht.
 *
 * Een pagina zonder tegenhanger krijgt geen hreflang. Een halve
 * verwijzing is erger dan geen: dan belooft hij een pagina die niet
 * bestaat.
 */
const alternatieven = TALEN.map((ander) => ({
  taal: ander,
  pad: tegenhanger(Astro.url.pathname, ander),
})).filter((rij): rij is { taal: Taal; pad: string } => Boolean(rij.pad));
const heeftPaar = alternatieven.length === TALEN.length;

/**
 * ProfessionalService is een soort LocalBusiness, dus adres en plaats
 * tellen mee voor zoekopdrachten met een stad erin. De @id maakt het op
 * elke pagina hetzelfde bedrijf en niet elke keer een nieuw.
 */
const bedrijfSchema = {
  "@type": "ProfessionalService",
  "@id": `${Astro.site}#bedrijf`,
  name: bedrijf.naam,
  description: beschrijving,
  url: Astro.site?.toString(),
  email: bedrijf.email,
  /* Dezelfde @id als het Person-blok op /over, zodat de oprichter en de
     persoon op die pagina één entiteit zijn en geen twee. */
  founder: {
    "@type": "Person",
    "@id": `${Astro.site}over/#joost`,
    name: bedrijf.persoon,
  },
  address: {
    "@type": "PostalAddress",
    streetAddress: bedrijf.straat,
    postalCode: bedrijf.postcode,
    addressLocality: bedrijf.plaats,
    addressCountry: "NL",
  },
  ...(bedrijf.onderdeelVan
    ? {
        parentOrganization: {
          "@type": "Organization",
          name: bedrijf.onderdeelVan,
        },
      }
    : {}),
  areaServed: [
    { "@type": "City", name: bedrijf.plaats },
    { "@type": "Country", name: t.algemeen.land },
  ],
  knowsAbout: [
    "Pipedrive",
    "CRM-implementatie",
    "n8n",
    "procesautomatisering",
    "systeemkoppelingen",
  ],
  sameAs: [bedrijf.linkedin],
  identifier: { "@type": "PropertyValue", name: "KvK", value: bedrijf.kvk },
};

/**
 * De site zelf als entiteit, met het bedrijf als uitgever. Dat maakt van
 * de losse pagina's één geheel voor een zoekmachine of een AI die de site
 * naloopt.
 */
const siteSchema = {
  "@type": "WebSite",
  "@id": `${Astro.site}#site`,
  name: bedrijf.naam,
  url: Astro.site?.toString(),
  inLanguage: taalcode[taal],
  publisher: { "@id": `${Astro.site}#bedrijf` },
};

/* Eén graph, zodat een pagina haar eigen blokken naast het bedrijf zet. */
const eigen = extraSchema
  ? Array.isArray(extraSchema)
    ? extraSchema
    : [extraSchema]
  : [];

const schema = {
  "@context": "https://schema.org",
  "@graph": [bedrijfSchema, siteSchema, ...eigen],
};
---

<!doctype html>
<html lang={taalcode[taal]} data-thema="donker">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#090e11" id="thema-kleur" />

    <script is:inline>
      /* Voor het schilderen, anders flitst de pagina donker op bij licht. */
      try {
        if (localStorage.getItem("thema") === "licht") {
          document.documentElement.dataset.thema = "licht";
          document.getElementById("thema-kleur")?.setAttribute("content", "#f8fafc");
        }
      } catch (e) {
        /* privemodus: dan gewoon donker */
      }
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--font-manrope" preload />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-ibm-plex-mono" />

    <title>{titel}</title>
    <meta name="description" content={beschrijving} />
    <link rel="canonical" href={canoniek} />
    {
      heeftPaar && (
        <>
          {alternatieven.map((rij) => (
            <link
              rel="alternate"
              hreflang={taalcode[rij.taal]}
              href={new URL(rij.pad, Astro.site)}
            />
          ))}
          <link
            rel="alternate"
            hreflang="x-default"
            href={new URL(
              alternatieven.find((rij) => rij.taal === "nl")!.pad,
              Astro.site,
            )}
          />
        </>
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogTaal[taal]} />
    <meta property="og:site_name" content={bedrijf.naam} />
    <meta property="og:title" content={titel} />
    <meta property="og:description" content={beschrijving} />
    <meta property="og:url" content={canoniek} />
    <meta property="og:image" content={ogAfbeelding} />
    <meta name="twitter:card" content="summary_large_image" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(schema)}
      is:inline
    />
  </head>
  <body class="bg-bg font-body text-tekst antialiased">
    <a
      href="#inhoud"
      class="fixed left-4 top-4 z-40 inline-flex min-h-11 -translate-y-24 items-center rounded-klein bg-accent px-5 py-2 text-sm font-medium tracking-[0.02em] text-op-accent focus:translate-y-0"
    >
      {t.algemeen.naarInhoud}
    </a>
    <Kop />
    <main id="inhoud">
      <slot />
    </main>
    <Voet />
    <ZwevendeKnop />

    {
      /* Cookieloos, dus geen melding nodig. Laadt alleen met een token. */
      analyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${analyticsToken}"}`}
        />
      )
    }
  </body>
</html>
