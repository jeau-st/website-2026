---
import type { Niveau } from "../data/site";

/**
 * Een niveau om jezelf in te herkennen. De herkenning staat groot, want
 * daar leest iemand zichzelf in; waar je begint staat eronder in de mono,
 * zodat het als aantekening leest en niet als tweede alinea.
 */
interface Props {
  niveau: Niveau;
}

const { niveau } = Astro.props;
---

<li class="border-t border-rand/60 py-8">
  <div class="grid gap-x-6 gap-y-2 sm:grid-cols-[4rem_1fr]">
    <p class="font-mono text-sm text-zacht" aria-hidden="true">
      {niveau.nummer}
    </p>
    <div class="min-w-0 max-w-2xl">
      <h3 class="text-xl text-tekst">{niveau.titel}</h3>
      <p class="mt-2 text-zacht">{niveau.herkenning}</p>
      <p class="mt-3 font-mono text-sm text-tekst">{niveau.begin}</p>
    </div>
  </div>
</li>
