---
import type { Processtap } from "../data/site";

interface Props {
  stap: Processtap;
  laatste?: boolean;
}

const { stap, laatste = false } = Astro.props;

const rollen = [
  { rol: "Ik doe", tekst: stap.ik },
  { rol: "Jij doet", tekst: stap.jij },
];
---

<li class="relative pl-10 sm:pl-14">
  {/* De lijn loopt door tot de volgende stap, maar niet voorbij de laatste */}
  {
    !laatste && (
      <span
        aria-hidden="true"
        class="absolute left-1.5 top-6 h-full w-px bg-rand sm:left-2"
      />
    )
  }
  <span
    aria-hidden="true"
    class="absolute left-0 top-[7px] size-3 border border-rand bg-vlak sm:size-4"
  ></span>

  <div class="pb-12">
    <p class="font-mono text-sm text-zacht">{stap.nummer}</p>
    <h3 class="mt-1 text-xl sm:text-2xl">
      {stap.titel}
    </h3>

    <dl class="mt-4 grid gap-4 sm:grid-cols-2">
      {
        rollen.map((item) => (
          <div>
            <dt class="text-sm font-semibold text-zacht">{item.rol}</dt>
            <dd class="mt-1 text-tekst">{item.tekst}</dd>
          </div>
        ))
      }
    </dl>

    <p class="mt-4 border-l border-rand pl-4 text-zacht">
      <span class="font-semibold text-tekst">Aan het eind: </span>
      {stap.resultaat}
    </p>
  </div>
</li>
