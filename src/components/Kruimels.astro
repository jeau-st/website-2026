---
/**
 * Het kruimelpad boven de kop op een pagina die onder een andere hangt.
 * Het staat er voor de bezoeker en voor de crawler: het BreadcrumbList
 * hoort erbij en wordt gemaakt met `kruimelSchema` hieronder, zodat de
 * zichtbare tekst en het schema niet uit elkaar kunnen lopen.
 *
 * De laatste kruimel is de pagina zelf en is dus geen link.
 */
import { taalUitPad } from "../data/taal";
import { teksten } from "../data/teksten";

export type Kruimel = { tekst: string; href?: string };

export function kruimelSchema(kruimels: Kruimel[], site: URL | undefined) {
  return {
    "@type": "BreadcrumbList",
    itemListElement: kruimels.map((kruimel, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: kruimel.tekst,
      ...(kruimel.href ? { item: new URL(kruimel.href, site).toString() } : {}),
    })),
  };
}

interface Props {
  kruimels: Kruimel[];
}

const { kruimels } = Astro.props;
const t = teksten[taalUitPad(Astro.url.pathname)];
---

<nav aria-label={t.algemeen.kruimelpad}>
  <ol class="flex flex-wrap items-center gap-x-2 label">
    {
      kruimels.map((kruimel, i) => (
        <li class="flex items-center gap-x-2">
          {i > 0 && <span aria-hidden="true">/</span>}
          {kruimel.href ? (
            <a class="tekstlink hover:text-tekst" href={kruimel.href}>
              {kruimel.tekst}
            </a>
          ) : (
            <span aria-current="page">{kruimel.tekst}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
