---
import { personen } from "../data/namen";

/**
 * Wisselt de naam in de kop bij elk bezoek. De pagina is statisch, dus de
 * naam die de build kiest zou maanden blijven staan; dit script kiest er
 * bij het laden een nieuwe, inclusief het bijbehorende haar of zijn.
 *
 * Het staat direct achter de tekst die het aanpast en niet onderaan de
 * pagina, want dan zie je de naam nog even verspringen. Zonder JavaScript
 * blijft de naam uit de build staan, en dat is een geldige kop.
 */
---

<script is:inline define:vars={{ personen }}>
  const gekozen = personen[Math.floor(Math.random() * personen.length)];

  for (const el of document.querySelectorAll("[data-naam]")) {
    el.textContent = gekozen.naam;
  }
  for (const el of document.querySelectorAll("[data-bezittelijk]")) {
    el.textContent = gekozen.bezittelijk;
  }
</script>
