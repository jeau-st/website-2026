---
import Kaart from "./Kaart.astro";
import Todo from "./Todo.astro";
import type { Case } from "../data/site";

/**
 * Zelfde opbouw als de dienstenlijst: een kaart met het nummer ernaast.
 */
interface Props {
  item: Case;
  nummer: string;
}

const { item, nummer } = Astro.props;

const delen = [
  { kop: "Situatie", tekst: item.situatie },
  { kop: "Aanpak", tekst: item.aanpak },
  { kop: "Resultaat", tekst: item.resultaat },
];

const schoon = (tekst: string) => tekst.replace(/^TODO:\s*/, "");
---

<Kaart als="li" id={`case-${nummer}`}>
  <div class="grid gap-x-8 gap-y-4 sm:grid-cols-[3rem_1fr]">
    <p class="font-mono text-sm text-zacht" aria-hidden="true">{nummer}</p>

    <div class="min-w-0">
      {
        item.todo ? (
          <Todo wat={schoon(item.titel)} />
        ) : (
          <h3 class="text-xl">{item.titel}</h3>
        )
      }

      <dl class="mt-4 grid gap-4 sm:grid-cols-3">
        {
          delen.map((deel) => (
            <div class="min-w-0">
              <dt class="font-mono text-sm text-zacht">{deel.kop}</dt>
              <dd class="mt-1 min-w-0 text-tekst">
                {item.todo ? <Todo wat={schoon(deel.tekst)} /> : deel.tekst}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</Kaart>
