---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

/**
 * Een foto in een lopend verhaal. Geen onderschrift: de tekst eromheen
 * vertelt het al, en een bijschrift dat hetzelfde zegt leest dubbel.
 * De alt blijft, die is voor wie de foto niet ziet.
 *
 * Smaller dan de tekstkolom breed is, zodat de foto's het verhaal
 * onderbreken zonder het over te nemen.
 */
interface Props {
  src: ImageMetadata;
  alt: string;
  /** Staand beeld staat smaller, anders vult het een heel scherm. */
  staand?: boolean;
}

const { src, alt, staand = false } = Astro.props;
---

<figure class:list={["my-10", staand ? "max-w-xs" : "max-w-xl"]}>
  <Image
    src={src}
    alt={alt}
    widths={staand ? [320, 567] : [576, 768, 1152]}
    sizes={staand ? "(min-width: 640px) 20rem, 100vw" : "(min-width: 640px) 36rem, 100vw"}
    class="w-full border border-rand/60"
  />
</figure>
