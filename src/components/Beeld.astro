---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

/**
 * Een foto met onderschrift in een lopend verhaal. De foto's breken de
 * tekst op, dus ze staan iets breder dan de tekstkolom: anders lees je
 * er doorheen zonder te stoppen.
 */
interface Props {
  src: ImageMetadata;
  alt: string;
  bijschrift: string;
  /** Staand beeld staat smaller, anders vult het een heel scherm. */
  staand?: boolean;
}

const { src, alt, bijschrift, staand = false } = Astro.props;
---

<figure class:list={["my-12", staand ? "max-w-sm" : "max-w-3xl"]}>
  <Image
    src={src}
    alt={alt}
    widths={staand ? [384, 620] : [672, 896, 1280]}
    sizes={staand ? "(min-width: 640px) 24rem, 100vw" : "(min-width: 768px) 48rem, 100vw"}
    class="w-full border border-rand/60"
  />
  <figcaption class="mt-3 text-sm text-zacht">{bijschrift}</figcaption>
</figure>
