---
import Icoon from "./Icoon.astro";
import type { Dienst } from "../data/site";

/**
 * Een dienst als rij op de hub, met het nummer en het icoon in de
 * kantlijn en de steekwoorden erachter.
 *
 * Dit was een kaart. Op de homepage staat hetzelfde rijtje van vijf
 * sinds kort als band, en twee vormen voor één lijst leest als twee
 * verschillende lijsten. Nu allebei zonder vlak: daar vijf naast elkaar
 * met één regel, hier vijf onder elkaar met de volle tekst. De lijst
 * eromheen zet de haarlijn tussen de rijen.
 */
interface Props {
  dienst: Dienst;
  nummer: string;
}

const { dienst, nummer } = Astro.props;
---

<li class="relative bg-bg py-6 first:pt-0 last:pb-0">
  <div class="grid gap-x-8 gap-y-4 sm:grid-cols-[3rem_minmax(0,32rem)_1fr]">
    <div class="hidden sm:block" aria-hidden="true">
      <p class="label">{nummer}</p>
      <svg viewBox="0 0 24 24" class="mt-3 size-5 text-zacht">
        <Icoon naam={dienst.icoon} maat={24} />
      </svg>
    </div>

    <div class="min-w-0">
      {/* De link rekt zich over de hele rij uit, want als los stukje
          tekst was hij 24 px hoog en dat is op een telefoon te klein.
          Alleen de titel is de link; de rest blijft selecteerbaar. */}
      <h3 class="text-xl">
        <a class="tekstlink after:absolute after:inset-0" href={`/diensten/${dienst.slug}/`}>
          {dienst.titel}
        </a>
      </h3>
      <p class="mt-2 text-zacht">{dienst.tekst}</p>
    </div>

    <ul class="min-w-0 space-y-1 font-mono text-sm text-zacht">
      {dienst.punten.map((punt) => <li class="min-w-0">{punt}</li>)}
    </ul>
  </div>
</li>
