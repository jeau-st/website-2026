---
import type { Dienst } from "../data/site";

/**
 * Geen kaart in een raster maar een regel in een lijst, met de
 * steekwoorden als kantlijnnotitie. Leest als een tekening met
 * aantekeningen in plaats van als een blokkenschema.
 */
interface Props {
  dienst: Dienst;
  nummer: string;
}

const { dienst, nummer } = Astro.props;
---

<li class="border-t border-rand/60 py-6 first:border-t-0 first:pt-0">
  <div class="grid gap-x-8 gap-y-4 sm:grid-cols-[3rem_minmax(0,32rem)_1fr]">
    <p class="hidden font-mono text-sm text-zacht sm:block" aria-hidden="true">
      {nummer}
    </p>

    <div class="min-w-0">
      <h3 class="text-xl">{dienst.titel}</h3>
      <p class="mt-2 text-zacht">{dienst.tekst}</p>
    </div>

    <ul class="min-w-0 space-y-1 font-mono text-sm text-zacht">
      {dienst.punten.map((punt) => <li class="min-w-0">{punt}</li>)}
    </ul>
  </div>
</li>
