---
import type { Dienst } from "../data/site";

interface Props {
  dienst: Dienst;
}

const { dienst } = Astro.props;
---

<article class="border border-pigment/60 p-6 sm:p-8">
  <h3 class="text-xl font-semibold text-linnen">{dienst.titel}</h3>
  <p class="mt-3 text-muted">{dienst.tekst}</p>
  <ul class="mt-5 space-y-2">
    {
      dienst.punten.map((punt) => (
        <li class="flex gap-3 text-sm text-linnen">
          <span aria-hidden="true" class="mt-2 size-1.5 shrink-0 bg-oker" />
          <span class="min-w-0">{punt}</span>
        </li>
      ))
    }
  </ul>
</article>
