---
import Kaart from "./Kaart.astro";
import type { Dienst } from "../data/site";

/**
 * Een kaart per dienst, met de steekwoorden als kantlijnnotitie ernaast.
 * Het nummer en die kantlijn houden het een lijst met aantekeningen en
 * maken er geen blokkenschema van.
 */
interface Props {
  dienst: Dienst;
  nummer: string;
}

const { dienst, nummer } = Astro.props;
---

<Kaart als="li" class="relative">
  <div class="grid gap-x-8 gap-y-4 sm:grid-cols-[3rem_minmax(0,32rem)_1fr]">
    <p class="hidden label sm:block" aria-hidden="true">
      {nummer}
    </p>

    <div class="min-w-0">
      {/* De link rekt zich over de hele kaart uit, want als los stukje
          tekst was hij 24 px hoog en dat is op een telefoon te klein.
          Alleen de titel is de link; de rest blijft selecteerbaar. */}
      <h3 class="text-xl">
        <a
          class="tekstlink after:absolute after:inset-0 after:rounded-kaart"
          href={`/diensten/${dienst.slug}/`}
        >
          {dienst.titel}
        </a>
      </h3>
      <p class="mt-2 text-zacht">{dienst.tekst}</p>
    </div>

    <ul class="min-w-0 space-y-1 font-mono text-sm text-zacht">
      {dienst.punten.map((punt) => <li class="min-w-0">{punt}</li>)}
    </ul>
  </div>
</Kaart>
