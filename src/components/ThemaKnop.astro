---
import { taalUitPad } from "../data/taal";
import { teksten } from "../data/teksten";

/**
 * Wisselt tussen donker en licht en onthoudt de keuze.
 * Donker is de standaard, dus zonder keuze staat er niets in localStorage.
 *
 * Dit was een icoonknop, een zon of een maan, en daar was aan te zien wat
 * er stond maar niet dat er iets te kiezen viel. Nu is het een
 * schakelaar: een baan met twee standen en een blokje dat erin schuift.
 * Het blokje draagt het icoon van het thema dat aan staat, dus je ziet in
 * één keer waar je bent en dat het kan verspringen.
 *
 * De baan is volledig rond en het blokje is een rondje, zoals op een
 * telefoon. Dat is de enige plek op de site waar dat mag: de huisregel
 * zegt geen pillen, omdat het woordmerk een pixelvorm is, maar een
 * schakelaar is een vorm die iedereen kent en die kennis is meer waard
 * dan de consistentie van de ronding. Overal anders blijft de schaal
 * gelden.
 *
 * De maten sluiten op elkaar aan en dat is hier het hele werk. De baan
 * is 42 bij 24 met 1 px rand, dus binnenin 40 bij 22. Daar gaat 2 px
 * lucht omheen, dus het blokje is 18 en past precies tussen boven en
 * onder. Links en rechts blijft er 40 min 4 min 18 is 18 over, en dat is
 * exact wat het blokje opschuift. Zo is de lucht aan beide kanten gelijk
 * in allebei de standen.
 *
 * Het blokje staat links in donker en rechts in licht, de kant waar de
 * zon staat. Het schuift met transform in 150 ms; bij
 * `prefers-reduced-motion` zet global.css dat uit.
 *
 * `role="switch"` met `aria-checked`, want dat is wat dit is: een ding
 * met twee standen. Donker is aan. De twee labels staan als
 * data-attribuut op de knop, want het script hieronder staat in de
 * pagina en kent de taal niet.
 */
const t = teksten[taalUitPad(Astro.url.pathname)];
---

<button
  type="button"
  id="thema-knop"
  role="switch"
  aria-checked="true"
  aria-label={t.algemeen.themaLicht}
  data-label-licht={t.algemeen.themaLicht}
  data-label-donker={t.algemeen.themaDonker}
  class="drukbaar group inline-flex min-h-11 min-w-11 items-center justify-center text-zacht hover:text-tekst"
>
  <span
    aria-hidden="true"
    class="inline-flex h-6 w-[42px] items-center rounded-full border border-rand bg-kaart p-0.5"
  >
    <span
      class="thema-bol inline-flex size-[18px] items-center justify-center rounded-full bg-zacht text-bg transition-transform duration-150 group-hover:bg-tekst"
    >
      <svg
        viewBox="0 0 24 24"
        class="size-3"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
      >
        <circle class="thema-zon" cx="12" cy="12" r="4"></circle>
        <path
          class="thema-zon"
          d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.2 5.2l1.4 1.4M17.4 17.4l1.4 1.4M18.8 5.2l-1.4 1.4M6.6 17.4l-1.4 1.4"
        ></path>
        <path
          class="thema-maan"
          d="M20 14.2A8.2 8.2 0 0 1 9.8 4a8.4 8.4 0 1 0 10.2 10.2Z"
        ></path>
      </svg>
    </span>
  </span>
</button>

<style>
  /* Donker is de stand zonder attribuut, dus die staat hier als
     uitgangspunt en licht is de uitzondering. */
  #thema-knop .thema-zon {
    display: none;
  }

  :global([data-thema="licht"]) #thema-knop .thema-zon {
    display: inline;
  }

  :global([data-thema="licht"]) #thema-knop .thema-maan {
    display: none;
  }

  /* 42 breed, 1 px rand en 2 px lucht aan weerskanten, blokje van 18:
     dan blijft er precies 18 over om op te schuiven. */
  :global([data-thema="licht"]) #thema-knop .thema-bol {
    transform: translateX(18px);
  }
</style>

<script is:inline>
  (() => {
    const knop = document.getElementById("thema-knop");
    if (!knop) return;

    const bijwerken = (thema) => {
      const donker = thema === "donker";
      knop.setAttribute("aria-checked", String(donker));
      knop.setAttribute(
        "aria-label",
        donker ? knop.dataset.labelLicht : knop.dataset.labelDonker,
      );
    };

    bijwerken(document.documentElement.dataset.thema);

    let terugzetten;

    knop.addEventListener("click", () => {
      const nieuw =
        document.documentElement.dataset.thema === "donker" ? "licht" : "donker";

      /* Zet de overgang aan, wissel, en haal hem er daarna weer af. Zie
         de regel bij data-thema-wisselt in global.css. */
      document.documentElement.dataset.themaWisselt = "";
      clearTimeout(terugzetten);
      terugzetten = setTimeout(() => {
        delete document.documentElement.dataset.themaWisselt;
      }, 250);

      document.documentElement.dataset.thema = nieuw;
      document
        .getElementById("thema-kleur")
        ?.setAttribute("content", nieuw === "donker" ? "#090e11" : "#f8fafc");
      try {
        localStorage.setItem("thema", nieuw);
      } catch {
        /* privémodus: de keuze geldt dan alleen deze pagina */
      }
      bijwerken(nieuw);
    });
  })();
</script>
