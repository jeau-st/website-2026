---
/**
 * Wisselt tussen licht en donker en onthoudt de keuze.
 * Licht is de standaard, dus zonder keuze staat er niets in localStorage.
 */
---

<button
  type="button"
  id="thema-knop"
  class="inline-flex min-h-11 min-w-11 items-center justify-center text-zacht hover:text-tekst"
  aria-pressed="false"
  aria-label="Donkere modus aanzetten"
>
  <svg
    aria-hidden="true"
    viewBox="0 0 24 24"
    class="size-5"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
  >
    <circle class="thema-zon" cx="12" cy="12" r="4.5"></circle>
    <g class="thema-zon">
      <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.2 5.2l1.4 1.4M17.4 17.4l1.4 1.4M18.8 5.2l-1.4 1.4M6.6 17.4l-1.4 1.4"
      ></path>
    </g>
    <path
      class="thema-maan hidden"
      d="M20 14.2A8.2 8.2 0 0 1 9.8 4a8.4 8.4 0 1 0 10.2 10.2Z"
    ></path>
  </svg>
</button>

<style>
  :global([data-thema="donker"]) #thema-knop .thema-zon {
    display: none;
  }
  :global([data-thema="donker"]) #thema-knop .thema-maan {
    display: inline;
  }
</style>

<script is:inline>
  (() => {
    const knop = document.getElementById("thema-knop");
    if (!knop) return;

    const bijwerken = (thema) => {
      const donker = thema === "donker";
      knop.setAttribute("aria-pressed", String(donker));
      knop.setAttribute(
        "aria-label",
        donker ? "Lichte modus aanzetten" : "Donkere modus aanzetten",
      );
    };

    bijwerken(document.documentElement.dataset.thema);

    knop.addEventListener("click", () => {
      const nieuw =
        document.documentElement.dataset.thema === "donker" ? "licht" : "donker";
      document.documentElement.dataset.thema = nieuw;
      document
        .getElementById("thema-kleur")
        ?.setAttribute("content", nieuw === "donker" ? "#14202a" : "#e8e1cc");
      try {
        localStorage.setItem("thema", nieuw);
      } catch {
        /* privémodus: de keuze geldt dan alleen deze pagina */
      }
      bijwerken(nieuw);
    });
  })();
</script>
