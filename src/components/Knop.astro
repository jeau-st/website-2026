---
import { cta } from "../data/site";

/**
 * De primaire actie. Zonder planner-URL rendert dit bewust geen dode link
 * maar een zichtbare TODO, zodat het niet stil misgaat.
 */
interface Props {
  variant?: "gevuld" | "lijn";
  class?: string;
  toonToelichting?: boolean;
}

const { variant = "gevuld", class: extra = "", toonToelichting = false } = Astro.props;

/* Lichter dan hij was. Hij stond op 16 px semibold en dat schreeuwde:
   een knop die harder roept dan de kop eronder leest als sjabloon.
   Nu 14 px medium met positieve letterspatiering en meer horizontale
   ruimte, zodat hij rustig is en toch opvalt door zijn kleur. De hoogte
   komt op 49 px uit, dus ruim boven het tikdoel van 44. */
const basis =
  "drukbaar inline-flex items-center justify-center gap-2 rounded-klein px-7 py-3.5 text-sm font-medium tracking-[0.02em] transition-colors duration-150";
const stijl =
  variant === "gevuld"
    ? "bg-accent text-op-accent hover:bg-tekst"
    : "border border-rand text-tekst hover:border-accent hover:text-accent";
---

{
  cta.url ? (
    <a
      data-cta
      class:list={[basis, stijl, extra]}
      href={cta.url}
      target="_blank"
      rel="noopener"
    >
      {cta.label}
    </a>
  ) : (
    <span
      class:list={[
        "inline-flex items-center gap-2 border border-dashed border-accent/70 bg-accent/10 px-4 py-3 font-mono text-sm text-accent",
        extra,
      ]}
    >
      TODO: URL afspraakplanner
    </span>
  )
}
{
  toonToelichting && (
    <p class="mt-3 text-sm text-zacht">{cta.toelichting}</p>
  )
}
