---
import { cta } from "../data/site";

/**
 * De primaire actie. Zonder planner-URL rendert dit bewust geen dode link
 * maar een zichtbare TODO, zodat het niet stil misgaat.
 */
interface Props {
  variant?: "gevuld" | "lijn";
  class?: string;
  toonToelichting?: boolean;
}

const { variant = "gevuld", class: extra = "", toonToelichting = false } = Astro.props;

const basis =
  "inline-flex items-center justify-center gap-2 px-6 py-3 text-base font-semibold transition-colors duration-150";
const stijl =
  variant === "gevuld"
    ? "bg-oker text-ink hover:bg-linnen"
    : "border border-pigment text-linnen hover:border-oker hover:text-oker";
---

{
  cta.url ? (
    <a
      class:list={[basis, stijl, extra]}
      href={cta.url}
      target="_blank"
      rel="noopener"
    >
      {cta.label}
    </a>
  ) : (
    <span
      class:list={[
        "inline-flex items-center gap-2 border border-dashed border-oker/70 bg-oker/10 px-4 py-3 font-mono text-sm text-oker",
        extra,
      ]}
    >
      TODO: URL Pipedrive-afspraakplanner
    </span>
  )
}
{
  toonToelichting && (
    <p class="mt-3 text-sm text-muted">{cta.toelichting}</p>
  )
}
