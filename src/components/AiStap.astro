---
import Kaart from "./Kaart.astro";
import type { AiStap } from "../data/site";

/**
 * Een van de drie manieren waarop AI op je eigen gegevens werkt.
 * Een kaart, net als de andere rijtjes van drie op de site.
 */
interface Props {
  stap: AiStap;
}

const { stap } = Astro.props;
---

<Kaart krap>
  <p class="label" aria-hidden="true">{stap.nummer}</p>
  <h3 class="mt-3 text-lg">{stap.titel}</h3>
  <p class="mt-2 text-zacht">{stap.tekst}</p>
</Kaart>
