---
import type { AiStap } from "../data/site";

/**
 * Een van de drie manieren waarop AI op je eigen gegevens werkt.
 * Geen kaartje met een rand eromheen: op deze site scheidt een streep
 * boven de kolom, net als bij de processtappen.
 */
interface Props {
  stap: AiStap;
}

const { stap } = Astro.props;
---

<div class="border-t border-rand/60 pt-5">
  <p class="font-mono text-sm text-zacht" aria-hidden="true">{stap.nummer}</p>
  <h3 class="mt-3 text-lg">{stap.titel}</h3>
  <p class="mt-2 text-zacht">{stap.tekst}</p>
</div>
