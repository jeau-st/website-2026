---
import Icoon from "./Icoon.astro";
import { bouwstenen } from "../data/site";

/**
 * Het beeld waar de pagina om onthouden moet worden: alles wat bij een
 * bedrijf hoort, op één ring. Geen doos met pijlen ernaartoe, want dat
 * las als nog een systeem erbij. Eén cirkel waar alles op zit zegt het
 * zonder er een woord bij te hoeven zetten, en daarom staat er in het
 * midden ook niets.
 *
 * Een echte schematische tekening in svg. De iconen komen uit Lucide en
 * staan als los bestand in `src/icons`, zie `Icoon.astro`.
 *
 * De verdeling over de ring is niet willekeurig: wat je nu al hebt staat
 * op de linkerkant en bovenaan, wat het je oplevert op de rechterkant.
 * Wie met de klok mee leest, leest dus van bronnen naar opbrengst.
 *
 * De maat is gebonden aan de kolom waar hij in staat. Die kolom was de
 * helft van de hero en is nu 39 procent, want de kop moet ook bij de
 * langste naam op een regel passen: "Dat doet Sebastiaan altijd" is
 * 554 px bij 48 px Manrope. Bij max-w-5xl houdt de tekening dan 365 px
 * over. Groter en ze duwt de kop naar een tweede regel.
 *
 * Twee opmaken, en welke je ziet hangt af van de ruimte en niet van de
 * schermbreedte alleen. De volle ring met de labels voluit staat tussen
 * sm en lg: daar staat de tekening onder de tekst en heeft ze de hele
 * kolom. Op een telefoon en vanaf lg staat de compacte ring, en daar is
 * `kort` nodig: "slimme workflows" past niet naast de cirkel zonder dat
 * de cirkel te klein wordt om nog iets voor te stellen.
 *
 * Vanaf lg staat de tekening naast de kop, en die kolom is twee vijfde
 * van de hero: 365 px, want de kop moet ook bij de langste naam op een
 * regel passen. De volle ring is daar niet te krap maar te klein: hij
 * schaalt als geheel mee, dus de labels van 13 px zouden op 8 px
 * uitkomen. De compacte ring is op dat formaat getekend.
 *
 * Alles staat op `currentColor` en de kleuren komen uit de tokens, dus
 * hij kleurt mee met het thema. Het geheel is aria-hidden, de
 * figcaption vertelt hetzelfde in woorden.
 */

/**
 * De punten op de ring, uit dezelfde lijst als de bouwstenen bij de
 * opdrachten op /werk. De hoek is in graden, 0 is rechts en min 90 is
 * boven: twaalf onderdelen op stappen van dertig graden, met de klok mee
 * vanaf boven. De verdeling is niet willekeurig, dus de volgorde van de
 * lijst in site.ts is de volgorde op de ring: wat je nu al hebt staat op
 * de linkerkant en bovenaan, wat het je oplevert op de rechterkant.
 */
const punten = bouwstenen.map((steen, i) => ({
  ...steen,
  hoek: -90 + i * 30,
}));

/** Een punt op de ring. */
function opRing(hoek: number, cx: number, cy: number, r: number) {
  const rad = (hoek * Math.PI) / 180;
  return { x: cx + r * Math.cos(rad), y: cy + r * Math.sin(rad) };
}

/**
 * Waar het labeltje staat. Rechts van de ring lijnt het links uit, links
 * ervan rechts, en pal boven of onder staat het gecentreerd: anders valt
 * een label over de cirkel heen.
 */
function labelPlek(
  hoek: number,
  p: { x: number; y: number },
  weg: number,
  hoogte: number,
) {
  const cos = Math.cos((hoek * Math.PI) / 180);
  if (cos > 0.25) return { x: p.x + weg, y: p.y, anker: "start" };
  if (cos < -0.25) return { x: p.x - weg, y: p.y, anker: "end" };
  const boven = Math.sin((hoek * Math.PI) / 180) < 0;
  return { x: p.x, y: p.y + (boven ? -hoogte : hoogte), anker: "middle" };
}
---

<figure class="mt-8 sm:mt-0">
  {/* Vanaf sm: de volle ring */}
  <svg
    class="mx-auto hidden h-auto w-full max-w-[30rem] sm:block lg:hidden"
    viewBox="0 0 560 360"
    role="presentation"
    aria-hidden="true"
    font-family="var(--font-mono)"
  >
    <circle
      cx="250"
      cy="180"
      r="132"
      fill="none"
      stroke="var(--color-rand)"
      stroke-width="1.5"
    />
    {
      punten.map((punt, i) => {
        const p = opRing(punt.hoek, 250, 180, 132);
        const l = labelPlek(punt.hoek, p, 25, 28);
        return (
          <g class="punt">
            {/* De draden naar alle andere punten. Ze staan op nul en komen
                op als je dit punt aanwijst: dan zie je dat het niet twaalf
                losse dingen zijn maar twaalf dingen die met elkaar praten.
                Ze vangen zelf geen muis, anders houden ze de hover vast
                zodra ze verschijnen. */}
            <g class="draden">
              {punten.map((ander, j) => {
                if (j === i) return null;
                const q = opRing(ander.hoek, 250, 180, 132);
                return (
                  <line
                    x1={p.x}
                    y1={p.y}
                    x2={q.x}
                    y2={q.y}
                    stroke="var(--color-rand)"
                    stroke-dasharray="2 5"
                  />
                );
              })}
            </g>
            {/* Een schijfje op de lijn, gevuld met de kaartkleur, zodat
                de ring er netjes achter wegvalt. */}
            <circle
              class="schijf"
              cx={p.x}
              cy={p.y}
              r="17"
              fill="var(--color-kaart)"
              stroke="var(--color-rand)"
              stroke-width="1.5"
            />
            <g
              class="teken"
              transform={`translate(${p.x - 9} ${p.y - 9})`}
              style="color: var(--color-tekst)"
            >
              <Icoon naam={punt.icoon} maat={18} />
            </g>
            <text
              class="naam"
              x={l.x}
              y={l.y}
              text-anchor={l.anker}
              dominant-baseline="middle"
              font-size="13"
              fill="var(--color-tekst)"
            >
              {punt.label}
            </text>
          </g>
        );
      })
    }
  </svg>

  {/* Tot sm en weer vanaf lg: dezelfde ring, kleiner, met de korte labels */}
  <svg
    class="mx-auto h-auto w-full max-w-[22rem] sm:hidden lg:block lg:max-w-[22.5rem]"
    viewBox="0 0 340 340"
    role="presentation"
    aria-hidden="true"
    font-family="var(--font-mono)"
  >
    <circle
      cx="170"
      cy="170"
      r="72"
      fill="none"
      stroke="var(--color-rand)"
      stroke-width="1.5"
    />
    {
      punten.map((punt) => {
        const p = opRing(punt.hoek, 170, 170, 72);
        const l = labelPlek(punt.hoek, p, 19, 24);
        return (
          <>
            <circle
              cx={p.x}
              cy={p.y}
              r="13"
              fill="var(--color-kaart)"
              stroke="var(--color-rand)"
              stroke-width="1.5"
            />
            <g
              transform={`translate(${p.x - 7} ${p.y - 7})`}
              style="color: var(--color-tekst)"
            >
              <Icoon naam={punt.icoon} maat={14} />
            </g>
            <text
              x={l.x}
              y={l.y}
              text-anchor={l.anker}
              dominant-baseline="middle"
              font-size="10"
              fill="var(--color-tekst)"
            >
              {punt.kort ?? punt.label}
            </text>
          </>
        );
      })
    }
  </svg>

  <figcaption class="sr-only">
    Eén ring met alles erop wat bij het werk hoort. Aan de ene kant wat je
    nu al hebt: de mailbox, de boekhouding, offertes, WhatsApp, de
    telefoon, de website en de agenda. Aan de andere kant wat je eruit
    haalt: projecten, rapportages, slimme workflows, AI en databases.
  </figcaption>
</figure>

<style>
  /* Aanwijzen licht een punt op: het icoon en de rand van het schijfje
     gaan naar de kopkleur, het label wordt zwaarder, en de draden naar de
     andere elf punten komen op. Geen accent, want dat is voor de primaire
     actie. Alleen opacity en kleur, 150 ms, zoals alles op deze site. */
  .draden {
    opacity: 0;
    pointer-events: none;
    transition: opacity 150ms;
  }

  .punt:hover .draden {
    opacity: 1;
  }

  .schijf,
  .naam {
    transition:
      stroke 150ms,
      fill 150ms;
  }

  .teken {
    transition: color 150ms;
  }

  .punt:hover .schijf {
    stroke: var(--color-kop);
  }

  .punt:hover .teken {
    color: var(--color-kop);
  }

  .punt:hover .naam {
    fill: var(--color-kop);
    font-weight: 500;
  }

  @media (prefers-reduced-motion: reduce) {
    .draden,
    .schijf,
    .naam,
    .teken {
      transition: none;
    }
  }
</style>
