---
import Knop from "./Knop.astro";
import Woordmerk from "./Woordmerk.astro";
import ThemaKnop from "./ThemaKnop.astro";
import Icoon from "./Icoon.astro";
import { cta, diensten } from "../data/site";

/**
 * De kop blijft bovenaan staan en krimpt zodra je gaat scrollen: het
 * woordmerk wordt kleiner en de balk wordt lager. Zo heb je het menu
 * altijd bij de hand zonder dat het de halve pagina opeet.
 *
 * Diensten is een link naar de hub met een pijltje ernaast dat de lijst
 * uitklapt. Twee elementen, maar een trefvlak: de `group` op de wikkel
 * laat ze samen oplichten, want apart oplichtende helften lezen als twee
 * dingen naast elkaar in plaats van een menu-item met een pijltje. Zo
 * blijft de hub bereikbaar voor wie klikt en voor wie crawlt.
 *
 * Het paneel gaat open zodra je er met de muis op komt, en het pijltje
 * blijft een knop voor wie klikt of tabt. Op een aanraakscherm doet de
 * hover niets: daar volgt een tik gewoon de link.
 *
 * Vijf links passen niet naast het woordmerk, de themaknop en de knop.
 * Daarom staat het menu tot lg in een uitklapper. Dat is een details en
 * geen eigen knop met JavaScript: zo werkt het menu ook als het script
 * niet draait. Het uitklappen van Diensten in de balk heeft wel een
 * script nodig, en zonder dat script blijft de link het doen.
 */
const pad = Astro.url.pathname;

const links = [
  { href: "/diensten", tekst: "Diensten" },
  { href: "/aanpak", tekst: "Aanpak" },
  { href: "/werk", tekst: "Werk" },
  { href: "/over", tekst: "Over" },
  { href: "/contact", tekst: "Contact" },
];

/* Wat er onder Diensten hangt. De korte regel en het icoon staan bij de
   dienst zelf in site.ts, zodat het menu en de band op de homepage uit
   dezelfde bron komen en niet uit elkaar kunnen lopen.

   Wat Pipedrive kan stond hier als zesde regel onder een streepje. Dat
   was een uitzondering in een rijtje van vijf, en inhoudelijk hoort het
   bij de inrichting: daarom zit het nu in die eerste regel. De pagina
   zelf blijft bereikbaar vanaf de hub, elke dienstpagina en de voet. */
const onderDiensten = diensten.map((dienst) => ({
  href: `/diensten/${dienst.slug}/`,
  tekst: dienst.titel,
  uitleg: dienst.kort,
  icoon: dienst.icoon,
}));

/* Een dienstpagina laat Diensten oplichten, want die hangt eronder. */
const actief = (href: string) =>
  pad === href || pad === `${href}/` || pad.startsWith(`${href}/`);
---

<header
  data-kop
  class="sticky top-0 z-30 border-b border-rand/60 bg-bg/70 backdrop-blur-xl"
>
  <div
    class="kop-balk mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 sm:px-6"
  >
    <a
      href="/"
      class="inline-flex min-h-11 items-center text-merk"
      aria-current={pad === "/" ? "page" : undefined}
    >
      <Woordmerk class="kop-merk" />
    </a>

    <div class="flex items-center gap-2 sm:gap-4">
      <nav aria-label="Hoofdmenu" class="hidden items-center gap-7 lg:flex">
        {
          links.map((link) =>
            link.href === "/diensten" ? (
              <div class="group relative flex items-center" data-uitklap>
                <a
                  href={link.href}
                  aria-current={actief(link.href) ? "page" : undefined}
                  class:list={[
                    "inline-flex min-h-11 items-center text-sm group-hover:text-tekst",
                    actief(link.href)
                      ? "text-tekst underline underline-offset-8 decoration-rand"
                      : "text-zacht",
                  ]}
                >
                  {link.tekst}
                </a>
                <button
                  type="button"
                  data-uitklap-knop
                  aria-expanded="false"
                  aria-controls="menu-diensten"
                  aria-label="Alle diensten tonen"
                  class="drukbaar ml-1 inline-flex min-h-11 w-6 cursor-pointer items-center justify-center text-zacht group-hover:text-tekst"
                >
                  <svg
                    aria-hidden="true"
                    viewBox="0 0 24 24"
                    class="size-3.5 transition-transform duration-150"
                    data-uitklap-pijl
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M5 9l7 7 7-7" />
                  </svg>
                </button>

                <div
                  id="menu-diensten"
                  data-uitklap-paneel
                  class="absolute left-0 top-full z-40 mt-2 w-[24rem] rounded-kaart border border-rand bg-kaart p-2 shadow-xl before:absolute before:inset-x-0 before:-top-2 before:h-2 before:content-['']"
                >
                  <p class="px-3 pb-1 pt-2 label">
                    Vijf soorten werk
                  </p>
                  <ul class="grid gap-0.5">
                    {onderDiensten.map((item) => (
                      <li>
                        <a
                          href={item.href}
                          aria-current={actief(item.href) ? "page" : undefined}
                          class:list={[
                            "flex gap-3 rounded-klein px-3 py-2 hover:bg-bg active:bg-bg",
                            actief(item.href) ? "bg-bg" : "",
                          ]}
                        >
                          <svg
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                            class="mt-0.5 size-4 shrink-0 text-zacht"
                          >
                            <Icoon naam={item.icoon} maat={24} />
                          </svg>
                          <span class="min-w-0">
                            <span class="block text-sm text-tekst">
                              {item.tekst}
                            </span>
                            <span class="mt-0.5 block text-xs text-zacht">
                              {item.uitleg}
                            </span>
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            ) : (
              <a
                href={link.href}
                aria-current={actief(link.href) ? "page" : undefined}
                class:list={[
                  "inline-flex min-h-11 items-center text-sm hover:text-tekst",
                  actief(link.href)
                    ? "text-tekst underline underline-offset-8 decoration-rand"
                    : "text-zacht",
                ]}
              >
                {link.tekst}
              </a>
            ),
          )
        }
      </nav>

      <ThemaKnop />

      {
        /* Zonder planner-URL staat de TODO in de hero; in het menu zou hij
           de balk uit elkaar trekken. Verbergen gebeurt op de span: de
           knop zet zelf inline-flex, en dat wint het van hidden. */
        cta.url && (
          <span class="hidden sm:inline-flex">
            <Knop variant="lijn" class="px-4 py-2 text-sm" />
          </span>
        )
      }

      <details class="relative lg:hidden" data-menu>
        <summary
          class="drukbaar inline-flex min-h-11 min-w-11 cursor-pointer list-none items-center justify-center text-zacht hover:text-tekst"
          aria-label="Menu"
        >
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            class="size-5"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
          >
            <path class="menu-streep" d="M3.5 7h17M3.5 12h17M3.5 17h17"></path>
            <path class="menu-kruis hidden" d="M5.5 5.5l13 13M18.5 5.5l-13 13"
            ></path>
          </svg>
        </summary>

        <nav
          aria-label="Menu"
          class="absolute right-0 top-full z-40 mt-3 w-64 rounded-kaart border border-rand bg-kaart p-2 shadow-xl"
        >
          <ul>
            {
              links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    aria-current={actief(link.href) ? "page" : undefined}
                    class:list={[
                      "flex min-h-11 items-center rounded-klein px-3 hover:bg-bg hover:text-tekst active:bg-bg",
                      actief(link.href) ? "bg-bg text-tekst" : "text-zacht",
                    ]}
                  >
                    {link.tekst}
                  </a>
                  {/* De diensten hangen eronder, dus ze staan ingesprongen
                      in dezelfde lijst. Geen tweede uitklapper in een
                      uitklapper: dat is op een telefoon niet te raken. */}
                  {link.href === "/diensten" && (
                    <ul class="mb-1 ml-3 border-l border-rand/60 pl-2">
                      {onderDiensten.map((item) => (
                        <li>
                          <a
                            href={item.href}
                            aria-current={
                              actief(item.href) ? "page" : undefined
                            }
                            class:list={[
                              "flex min-h-11 items-center gap-2.5 rounded-klein px-3 text-sm hover:bg-bg hover:text-tekst active:bg-bg",
                              actief(item.href)
                                ? "bg-bg text-tekst"
                                : "text-zacht",
                            ]}
                          >
                            <svg
                              viewBox="0 0 24 24"
                              aria-hidden="true"
                              class="size-4 shrink-0"
                            >
                              <Icoon naam={item.icoon} maat={24} />
                            </svg>
                            <span class="min-w-0">{item.tekst}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))
            }
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<style is:global>
  /* De hoogtes staan hier en niet als utility, want ze horen bij elkaar:
     de balk en het woordmerk krimpen samen. */
  .kop-balk {
    padding-block: 1rem;
    transition: padding-block 150ms ease;
  }
  .kop-merk {
    display: block;
    width: auto;
    height: 1.5rem;
    transition: height 150ms ease;
  }
  @media (min-width: 640px) {
    .kop-merk {
      height: 1.75rem;
    }
  }
  [data-kop][data-compact] .kop-balk {
    padding-block: 0.5rem;
  }
  [data-kop][data-compact] .kop-merk {
    height: 1.125rem;
  }
  @media (min-width: 640px) {
    [data-kop][data-compact] .kop-merk {
      height: 1.25rem;
    }
  }

  /* De kop is doorschijnend met een blur erachter. Dat werkt alleen als
     de browser het kan en de bezoeker het wil; in allebei de andere
     gevallen wordt hij gewoon dekkend. Zonder deze terugval leest de
     tekst eronderdoor mee. */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    [data-kop] {
      background-color: var(--color-bg);
    }
  }
  @media (prefers-reduced-transparency: reduce) {
    [data-kop] {
      background-color: var(--color-bg);
      backdrop-filter: none;
    }
  }

  /* Punt 5: het paneel komt uit zijn eigen knop vandaan en gaat langs
     dezelfde weg terug. visibility staat erbij zodat het paneel dicht
     niet aan te tikken is en niet in de voorleesvolgorde staat.
     Zonder JavaScript blijft het dicht, en dan is de link naar /diensten
     het hele menu. */
  [data-uitklap-paneel] {
    visibility: hidden;
    opacity: 0;
    transform: scale(0.96);
    transform-origin: top left;
    transition:
      opacity 150ms ease,
      transform 150ms ease,
      visibility 0s linear 150ms;
  }
  [data-uitklap-paneel][data-open] {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition-delay: 0s;
  }

  /* Het mobiele menu is een details, en display valt niet te animeren.
     Daarom alleen bij het opengaan, vanuit de hoek waar de knop staat.
     Dichtgaan is direct: dat is wat een details doet. */
  details[data-menu][open] > nav {
    transform-origin: top right;
    animation: menu-open 150ms ease;
  }
  @keyframes menu-open {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
  }

  /* Safari zet standaard een driehoekje voor de summary. */
  summary::-webkit-details-marker {
    display: none;
  }
  details[data-menu][open] .menu-streep {
    display: none;
  }
  details[data-menu][open] .menu-kruis {
    display: inline;
  }
  [data-uitklap-knop][aria-expanded="true"] [data-uitklap-pijl] {
    transform: rotate(180deg);
  }
</style>

<script is:inline>
  (() => {
    /* Krimpen bij scrollen. Pas na 40 px, anders flikkert de balk bij het
       kleinste duwtje. */
    const kop = document.querySelector("[data-kop]");
    if (kop) {
      let bezig = false;
      const meten = () => {
        bezig = false;
        if (window.scrollY > 40) kop.setAttribute("data-compact", "");
        else kop.removeAttribute("data-compact");
      };
      meten();
      window.addEventListener(
        "scroll",
        () => {
          if (bezig) return;
          bezig = true;
          requestAnimationFrame(meten);
        },
        { passive: true },
      );
    }

    /* De uitklapper onder Diensten. Zonder dit script blijft de link naar
       /diensten gewoon werken, en dat is ook het hele menu. */
    const uitklap = document.querySelector("[data-uitklap]");
    if (uitklap) {
      const knop = uitklap.querySelector("[data-uitklap-knop]");
      const paneel = uitklap.querySelector("[data-uitklap-paneel]");

      const zetten = (open) => {
        paneel.toggleAttribute("data-open", open);
        knop.setAttribute("aria-expanded", String(open));
        knop.setAttribute(
          "aria-label",
          open ? "Alle diensten verbergen" : "Alle diensten tonen",
        );
      };

      const open = () => paneel.hasAttribute("data-open");

      knop.addEventListener("click", () => {
        /* Een klik wint altijd van de hover eronder: anders kun je hem
           met de muis erop niet dichtklikken. */
        clearTimeout(sluitTimer);
        zetten(!open());
      });

      /* Opengaan bij hover. Alleen met een muis: op een aanraakscherm
         vuurt pointerenter bij de tik waarmee je ook de link volgt, en
         dan klapt er iets open dat je meteen weer verlaat.

         Dichtgaan met een kleine vertraging, want tussen de knop en het
         paneel zit lucht. Het paneel heeft daar een onzichtbare brug
         over, dus de vertraging is alleen de marge voor een muis die de
         bocht iets te ruim neemt. */
      let sluitTimer;
      const metMuis = (e) => e.pointerType === "mouse" || e.pointerType === "";

      uitklap.addEventListener("pointerenter", (e) => {
        if (!metMuis(e)) return;
        clearTimeout(sluitTimer);
        zetten(true);
      });

      uitklap.addEventListener("pointerleave", (e) => {
        if (!metMuis(e)) return;
        clearTimeout(sluitTimer);
        sluitTimer = setTimeout(() => zetten(false), 180);
      });

      /* Met de tab-toets erheen doet hetzelfde als met de muis erheen. */
      uitklap.addEventListener("focusin", () => {
        clearTimeout(sluitTimer);
        zetten(true);
      });

      document.addEventListener("click", (e) => {
        if (open() && !uitklap.contains(e.target)) zetten(false);
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && open()) {
          clearTimeout(sluitTimer);
          zetten(false);
          knop.focus();
        }
      });

      /* Weg met de tab-toets betekent ook dicht. */
      uitklap.addEventListener("focusout", (e) => {
        if (open() && !uitklap.contains(e.relatedTarget)) {
          clearTimeout(sluitTimer);
          zetten(false);
        }
      });
    }

    /* De uitklapper op mobiel werkt zonder dit script. Dit sluit hem
       alleen ook bij Escape en bij een klik ernaast. */
    const menu = document.querySelector("details[data-menu]");
    if (menu) {
      document.addEventListener("click", (e) => {
        if (menu.open && !menu.contains(e.target)) menu.open = false;
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && menu.open) {
          menu.open = false;
          menu.querySelector("summary")?.focus();
        }
      });
    }
  })();
</script>
