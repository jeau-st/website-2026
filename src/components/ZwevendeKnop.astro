---
import { site } from "../data/site";
import { taalUitPad } from "../data/taal";

/**
 * De primaire actie op mobiel. In de balk bovenin paste hij niet: samen
 * met het woordmerk en drie links liep de koppenbalk over 375 px heen.
 * Daarom staat hij onderaan, waar je duim toch al zit.
 *
 * Een balk over de hele breedte en geen zwevende pil. Die pil lag op de
 * homepage midden op de kaart met de kernpunten, en dat las als een
 * ongelukje. Een balk met een rand erboven is herkenbaar als vaste
 * bediening, en de inhoud schuift eronder door in plaats van eronder weg
 * te vallen.
 *
 * Hij begint weg en komt pas tevoorschijn zodra de echte knop uit beeld
 * is: twee keer dezelfde actie onder elkaar is er een te veel. Andersom
 * begonnen is hoe het eerst stond, en dan stond de balk er bij het laden
 * meteen, om een tel later weg te schuiven omdat de knop in de hero
 * gewoon in beeld stond. Dat je hem ziet komen en gaan voordat je iets
 * gedaan hebt, is precies wat vaste bediening niet moet doen.
 *
 * Zonder JavaScript staat hij er wel, want dan is er niets dat hem kan
 * laten komen. Dat regelt de noscript hieronder, en dat is de veilige
 * kant.
 *
 * Vanaf sm staat de knop weer gewoon in de koppenbalk, dus dan is deze
 * er niet. Zonder planner-URL rendert hij niets; de hero toont dan de
 * TODO.
 */
const { cta } = site(taalUitPad(Astro.url.pathname));
---

{
  cta.url && (
    <div
      data-onderbalk
      data-weg
      class="fixed inset-x-0 bottom-0 z-30 border-t border-rand bg-bg px-4 pb-[calc(0.75rem+env(safe-area-inset-bottom,0px))] pt-3 sm:hidden"
    >
      <a
        class="drukbaar flex min-h-11 w-full items-center justify-center rounded-klein bg-accent px-5 py-3 text-sm font-medium tracking-[0.02em] text-op-accent"
        href={cta.url}
        target="_blank"
        rel="noopener"
      >
        {cta.label}
      </a>
    </div>
  )
}

<noscript>
  <style>
    [data-onderbalk][data-weg] {
      pointer-events: auto;
      opacity: 1;
      transform: none;
    }
  </style>
</noscript>

<style>
  /* Alleen opacity en transform, en de balk is niet aan te tikken als
     hij weg is. Even lang als de andere overgangen op de site. */
  [data-onderbalk] {
    transition:
      opacity 150ms ease,
      transform 150ms ease;
  }
  [data-onderbalk][data-weg] {
    pointer-events: none;
    opacity: 0;
    transform: translateY(100%);
  }
</style>

<script is:inline>
  (() => {
    const balk = document.querySelector("[data-onderbalk]");
    if (!balk) return;

    /* De balk staat in de html al weg. Kan deze browser niet zien wat er
       in beeld staat, dan zetten we hem gewoon neer: dan is hij er een
       keer te veel, en dat is beter dan een actie die ontbreekt. */
    const tonen = () => balk.removeAttribute("data-weg");

    if (!("IntersectionObserver" in window)) {
      tonen();
      return;
    }

    const start = () => {
      const echte = [...document.querySelectorAll("[data-cta]")];
      if (echte.length === 0) {
        tonen();
        return;
      }

      const inBeeld = new Set();
      const waarnemer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) inBeeld.add(entry.target);
          else inBeeld.delete(entry.target);
        }
        balk.toggleAttribute("data-weg", inBeeld.size > 0);
      });

      for (const knop of echte) waarnemer.observe(knop);
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", start);
    } else {
      start();
    }
  })();
</script>
