---
/**
 * Vaste breedte en ritme voor elke sectie op de site.
 *
 * Geen afwisselende banen en geen scheidingslijn: de hele pagina staat
 * op een achtergrond, en wat bij elkaar hoort staat in een Kaart. Het
 * ritme komt dus van de lucht tussen de secties.
 *
 * Hier stond eerst dat een labeltje boven de kop als sjabloon leest. Dat
 * klopt voor een los woord in een pilletje, maar niet voor een nummer:
 * op een pagina met zeven secties onder elkaar is `03` de enige
 * aanwijzing waar je bent zonder de inhoudsopgave erbij te pakken. Het
 * staat links en niet gecentreerd, want de pagina leest van links. Het
 * is aria-hidden: de nummering is houvast voor het oog, en een
 * screenreader heeft de koppenstructuur al.
 *
 * De eerste regel onder de kop staat op `mt-10`, overal. Dat is geen
 * regel van dit component maar van de pagina's die hem gebruiken, want
 * de inhoud komt uit de slot. Stond er hier en daar `mt-8` of `mt-12`,
 * en dan zie je dezelfde kop de ene keer dichter op zijn tekst staan
 * dan de andere zonder dat iemand dat zo bedoeld heeft.
 *
 * Het ritme is niet overal gelijk. `aansluitend` zet de bovenruimte
 * terug voor een sectie die bij de vorige hoort: dan ademt de pagina in
 * groepen in plaats van overal even hard te tikken.
 */
interface Props {
  id?: string;
  kop?: string;
  intro?: string;
  /** Het nummer in de kantlijn, bijvoorbeeld 3 wordt `03`. */
  nummer?: number;
  /** Krap tegen de vorige sectie aan, omdat ze bij elkaar horen. */
  aansluitend?: boolean;
  /**
   * Kop, intro en inhoud in het midden. Voor een sectie die om een
   * tekening heen staat: dan hoort de tekst bij het midden en niet bij
   * de linkerkantlijn.
   */
  gecentreerd?: boolean;
  /**
   * Zonder eigen kantlijn en breedte, voor een sectie die al in een
   * kolom staat. Dat is zo op de pagina's met een inhoudsopgave: daar
   * bepaalt het raster eromheen de breedte.
   */
  vol?: boolean;
  class?: string;
}

const {
  id,
  kop,
  intro,
  nummer,
  aansluitend = false,
  gecentreerd = false,
  vol = false,
  class: extra = "",
} = Astro.props;
const kopId = id ? `${id}-kop` : undefined;

/**
 * Een sectie heeft alleen bovenruimte. Het gat tussen twee blokken is
 * dan van de sectie die begint, en niet de som van de onderruimte van
 * de een en de bovenruimte van de ander. Zo staat er één getal voor één
 * gat, op één plek.
 *
 * Twee maten, en niet meer: 112 px tussen twee onderwerpen, oplopend
 * naar 128, en de helft daarvan, 56 en 64, voor een blok dat bij het
 * vorige hoort. Die verhouding van twee op een is wat je ziet: groepen
 * staan verder uit elkaar dan de delen binnen een groep.
 *
 * De onderkant van de pagina komt van `main` in Basis.astro, want dat
 * is weer één gat met één eigenaar.
 */
const ruimte = vol
  ? aansluitend
    ? "pt-14 sm:pt-16"
    : "pt-28 sm:pt-32"
  : aansluitend
    ? "px-4 pt-14 sm:px-6 sm:pt-16"
    : "px-4 pt-28 sm:px-6 sm:pt-32";
---

<section
  id={id}
  aria-labelledby={kop ? kopId : undefined}
  class:list={[ruimte, extra]}
>
  <div
    class:list={[
      vol ? "min-w-0" : "mx-auto max-w-5xl",
      gecentreerd && "text-center",
    ]}
  >
    {
      (kop || intro) && (
        <header class:list={["max-w-2xl", gecentreerd && "mx-auto text-center"]}>
          {nummer !== undefined && (
            <p class="label mb-3" aria-hidden="true">
              {String(nummer).padStart(2, "0")}
            </p>
          )}
          {kop && (
            <h2 id={kopId} class="text-3xl sm:text-4xl">
              {kop}
            </h2>
          )}
          {intro && <p class="mt-4 text-lg text-zacht">{intro}</p>}
        </header>
      )
    }
    <slot />
  </div>
</section>
