---
import Woordmerk from "./Woordmerk.astro";
import { bedrijf, site } from "../data/site";
import { dienstPad, routes, taalUitPad } from "../data/taal";
import { teksten, vul } from "../data/teksten";

/**
 * Drie kolommen: wie het is, wat er te koop is, en met wie je te maken
 * hebt. Dat laatste staat rechts, want het is het minst waarvoor je komt
 * en het meest waarnaar je zoekt als je het nodig hebt.
 *
 * Er heeft een kolom "Links" gestaan met LinkedIn, Over Jeau.st, .st?!
 * en Privacy erin. Dat was een kolom die zichzelf moest uitleggen, en
 * die vier horen alle vier ergens anders: LinkedIn bij de gegevens, want
 * daar bereik je iemand mee. Privacy en `.st?!` achter het copyright:
 * dat is de regel voor wat over de site zelf gaat en niet over het werk.
 * En Over Jeau.st nergens meer: die staat al in de kop.
 *
 * Studio Citadel staat in de eerste kolom, onder het woordmerk. Het zegt
 * iets over wie hier spreekt, niet over waar het bedrijf staat
 * ingeschreven, dus het hoort bij het merk en niet bij de gegevens. Een
 * maat kleiner dan de rest: het is een bijzin, geen bewering, en hij
 * staat onderaan uitgelijnd: de kolom is een flexkolom en de wikkel
 * eromheen heeft mt-auto, dus hij zakt naar de onderkant van de
 * hoogste kolom in plaats van tegen de belofte aan te plakken. De
 * pt-10 is de ondergrens voor als deze kolom zelf de hoogste is.
 * De regel
 * breekt met de hand achter "van", want anders bepaalt de kolombreedte
 * waar hij omslaat en staat "collectief" los van de naam erachter.
 *
 * De bedrijfsgegevens staan als tekst, net als op de contactpagina. De
 * mail staat daar ook, want het is een gegeven en geen bestemming, ook
 * al kun je erop klikken. Elke regel in de voet is daarom 32 px hoog,
 * of hij nu een link is of niet, zodat het adresblok hetzelfde ritme
 * houdt als het lijstje ernaast.
 */

const taal = taalUitPad(Astro.url.pathname);
const t = teksten[taal];
const { diensten } = site(taal);

const jaar = new Date().getFullYear();

/**
 * Twee klassen voor alle links in de voet, anders staan ze er negen keer.
 *
 * Geen onderstreping, anders staat de voet vol strepen. Wat de link
 * aanwijsbaar maakt is de kleur die naar de tekstkleur gaat, en op een
 * telefoon `drukbaar`: daar bestaat hover niet, en zonder streep is er
 * dan niets meer dat zegt dat er iets gebeurt.
 *
 * Een link in een rijtje is `block` met ruimte boven en onder, dus het
 * aanraakvlak is de hele regelbreedte van de kolom en niet alleen de
 * letters. Dat scheelt mikken zonder dat er lucht tussen de regels
 * komt: een regel is 32 px, waar `min-h-11` er 48 van maakte. Twaalf
 * regels van 48 lazen als een lijst met gaten.
 *
 * Een link die zelf een kop is, of die in een lopende regel staat,
 * krijgt die ruimte niet. Anders is de kop hoger dan de koppen van de
 * andere kolommen en zakt zijn tekst naar het midden, en dan staat één
 * van de drie kolommen lager dan de rest.
 */
const link = "drukbaar block py-1.5 transition-colors hover:text-tekst";
const kopLink = "drukbaar transition-colors hover:text-tekst";
---

<footer class="border-t border-rand/60 px-4 pb-28 pt-14 sm:px-6 sm:pb-14">
  <div class="mx-auto grid max-w-5xl gap-10 sm:grid-cols-2 lg:grid-cols-3">
    <div class="flex flex-col">
      {/* self-start, want de kolom is een flexkolom en die rekt zijn
          kinderen in de breedte op. De svg heeft w-auto, dus hij rekte
          mee tot de kolombreedte, en dan zet preserveAspectRatio de
          tekening midden in dat te brede vak: het woordmerk stond
          ineens gecentreerd. */}
      <Woordmerk class="h-6 self-start" />
      <p class="mt-3 text-sm text-zacht">
        {t.voet.belofte}
      </p>
      {/* Studio Citadel is het collectief waar Jeau.st zit. Het beeldmerk
          is hun eigen favicon: een uitsnede van het bastion, wit op
          grijsgroen. Dat het vlak zijn eigen achtergrond meebrengt is hier
          handig, want het enige andere dat ze publiceren is een lichte
          png van het woordmerk, en die valt in het lichte thema weg.

          Geen pijltje achter de link. Dat is voor een pagina van deze
          site, en dit gaat naar buiten. */}
      <div class="mt-auto pt-10">
        <a
          class="drukbaar inline-flex items-center gap-3 text-xs text-zacht transition-colors hover:text-tekst"
          href="https://www.studiocitadel.nl/"
          target="_blank"
          rel="noopener"
        >
          <img
            src="/studio-citadel.png"
            alt=""
            width="128"
            height="128"
            loading="lazy"
            class="size-8 shrink-0 rounded-klein"
          />
          {/* Twee regels met een harde breuk ertussen, want anders bepaalt
              de kolombreedte waar hij omslaat. In het Engels staat het
              lidwoord op een andere plek, dus het zijn twee hele regels uit
              `teksten` en geen zin die hier in stukken wordt geknipt. */}
          <span class="min-w-0">
            {vul(t.voet.onderdeelVan1, { naam: bedrijf.naam })}<br />{
              vul(t.voet.onderdeelVan2, { studio: bedrijf.onderdeelVan })
            }
          </span>
        </a>
      </div>
    </div>

    <div>
      <h2 class="text-sm font-semibold">
        <a class={kopLink} href={routes.diensten[taal]}>{t.voet.diensten}</a>
      </h2>
      <ul class="mt-1 text-sm text-zacht">
        {
          diensten.map((dienst) => (
            <li>
              <a class={link} href={dienstPad(dienst.slug, taal)}>
                {dienst.titel}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-semibold">{bedrijf.naam}</h2>
      <div class="mt-1 text-sm text-zacht">
        {/* Eén link over allebei de regels en niet twee losse: het is
            één adres en één bestemming. Geen pijltje, dat is voor een
            pagina van deze site. */}
        <a
          class={`${link} not-italic`}
          href={bedrijf.kaartUrl}
          target="_blank"
          rel="noopener"
        >
          <span class="block">{bedrijf.straat}</span>
          <span class="block">
            {bedrijf.postcode}&nbsp;{bedrijf.plaats}
          </span>
        </a>
        <a
          class={`${link} min-w-0 break-words`}
          href={`mailto:${bedrijf.email}`}
        >
          {bedrijf.email}
        </a>
        <p class="py-1.5">{t.algemeen.kvk}&nbsp;{bedrijf.kvk}</p>
        <a
          class={link}
          href={bedrijf.linkedin}
          target="_blank"
          rel="noopener"
        >
          {t.voet.linkedin}
        </a>
      </div>
    </div>
  </div>

  <p
    class="mx-auto mt-12 flex max-w-5xl flex-wrap items-center gap-x-5 text-sm text-zacht"
  >
    <span>&copy; {jaar} {bedrijf.naam}</span>
    <a class={kopLink} href={routes.privacy[taal]}>{t.voet.privacy}</a>
    <a class={kopLink} href={routes.st[taal]}>{t.voet.st}</a>
  </p>
</footer>
