---
import Woordmerk from "./Woordmerk.astro";
import { bedrijf, diensten } from "../data/site";

const jaar = new Date().getFullYear();
---

<footer class="border-t border-rand/60 px-4 pb-28 pt-14 sm:px-6 sm:pb-14">
  <div class="mx-auto grid max-w-5xl gap-10 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <Woordmerk class="h-6 text-merk" />
      <p class="mt-3 text-sm text-zacht">
        CRM en procesautomatisering voor mkb en scale-ups.
      </p>

      {/* Studio Citadel is het collectief waar Jeau.st zit. Het beeldmerk
          is hun eigen favicon: een uitsnede van het bastion, wit op
          grijsgroen. Dat het vlak zijn eigen achtergrond meebrengt is hier
          handig, want het enige andere dat ze publiceren is een lichte
          png van het woordmerk, en die valt in het lichte thema weg.

          Geen pijltje achter de link. Dat is voor een pagina van deze
          site, en dit gaat naar buiten. */}
      <a
        class="drukbaar mt-6 inline-flex max-w-xs items-center gap-3 text-sm text-zacht transition-colors hover:text-tekst"
        href="https://www.studiocitadel.nl/"
        target="_blank"
        rel="noopener"
      >
        <img
          src="/studio-citadel.png"
          alt=""
          width="128"
          height="128"
          loading="lazy"
          class="size-9 shrink-0 rounded-klein"
        />
        <span class="min-w-0">
          Joost is onderdeel van het collectief Studio Citadel
        </span>
      </a>
    </div>

    <div>
      <h2 class="text-sm font-semibold">
        <a
          class="tekstlink inline-flex min-h-11 items-center hover:text-tekst"
          href="/diensten">Diensten</a
        >
      </h2>
      <ul class="mt-2 space-y-1 text-sm text-zacht">
        {
          diensten.map((dienst) => (
            <li>
              <a
                class="tekstlink inline-flex min-h-11 items-center hover:text-tekst"
                href={`/diensten/${dienst.slug}/`}
              >
                {dienst.titel}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-semibold">Contact</h2>
      <ul class="mt-2 space-y-1 text-sm text-zacht">
        <li>
          <a class="tekstlink inline-flex min-h-11 items-center hover:text-tekst" href={`mailto:${bedrijf.email}`}>
            {bedrijf.email}
          </a>
        </li>
        <li>
          <a
            class="tekstlink inline-flex min-h-11 items-center hover:text-tekst"
            href={bedrijf.linkedin}
            target="_blank"
            rel="noopener"
          >
            LinkedIn
          </a>
        </li>
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-semibold">Jeau.st</h2>
      <ul class="mt-2 space-y-1 text-sm text-zacht">
        <li>{bedrijf.plaats}</li>
        <li>KvK&nbsp;{bedrijf.kvk}</li>
        <li><a class="tekstlink inline-flex min-h-11 items-center hover:text-tekst" href="/over">Over Jeau.st</a></li>
        <li><a class="tekstlink inline-flex min-h-11 items-center hover:text-tekst" href="/st">.st?!</a></li>
        <li><a class="tekstlink inline-flex min-h-11 items-center hover:text-tekst" href="/privacy">Privacy</a></li>
      </ul>
    </div>
  </div>

  <p class="mx-auto mt-12 max-w-5xl text-sm text-zacht">
    &copy; {jaar} {bedrijf.naam}
  </p>
</footer>
