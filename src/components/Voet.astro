---
import { bedrijf } from "../data/site";

const jaar = new Date().getFullYear();
---

<footer class="border-t border-rand/60 px-4 py-14 sm:px-6">
  <div class="mx-auto grid max-w-5xl gap-10 sm:grid-cols-3">
    <div>
      <p class="font-mono text-lg font-semibold text-tekst">jeau.st</p>
      <p class="mt-3 text-sm text-zacht">
        CRM, koppelingen en procesautomatisering voor MKB en scale-ups.
      </p>
    </div>

    <div>
      <h2 class="text-sm font-semibold text-tekst">Contact</h2>
      <ul class="mt-2 space-y-1 text-sm text-zacht">
        <li>
          <a class="tekstlink inline-flex min-h-11 items-center hover:text-tekst" href={`mailto:${bedrijf.email}`}>
            {bedrijf.email}
          </a>
        </li>
        <li>
          <a class="tekstlink inline-flex min-h-11 items-center hover:text-tekst" href={bedrijf.telefoonLink}>
            {bedrijf.telefoon}
          </a>
        </li>
        <li>
          <a
            class="tekstlink inline-flex min-h-11 items-center hover:text-tekst"
            href={bedrijf.linkedin}
            target="_blank"
            rel="noopener"
          >
            LinkedIn
          </a>
        </li>
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-semibold text-tekst">Jeau.st</h2>
      <ul class="mt-2 space-y-1 text-sm text-zacht">
        <li>{bedrijf.plaats}</li>
        <li>KvK&nbsp;{bedrijf.kvk}</li>
        <li><a class="tekstlink inline-flex min-h-11 items-center hover:text-tekst" href="/privacy">Privacy</a></li>
      </ul>
    </div>
  </div>

  <p class="mx-auto mt-12 max-w-5xl text-sm text-zacht">
    &copy; {jaar} {bedrijf.naam}
  </p>
</footer>
