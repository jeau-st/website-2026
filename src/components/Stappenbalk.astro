---
import { processtappen } from "../data/site";

/**
 * De zes projectstappen als balk in plaats van als zes tekstblokken.
 * Voluit staan ze op /aanpak; hier hoeft de bezoeker alleen te zien dat
 * er een volgorde is en hoe lang die is. Scheelt op de homepage ruim
 * tweehonderd woorden en tweeduizend pixels.
 */
---

<ol
  class="mt-10 grid gap-x-6 gap-y-4 sm:grid-cols-3 lg:grid-cols-6"
  aria-label="De zes stappen van een traject"
>
  {
    processtappen.map((stap) => (
      <li class="min-w-0 border-t border-rand pt-3">
        <p class="font-mono text-xs text-zacht" aria-hidden="true">
          {stap.nummer}
        </p>
        <p class="mt-1 min-w-0 text-tekst">{stap.titel}</p>
      </li>
    ))
  }
</ol>
