---
/**
 * De inhoudsopgave naast een lange pagina. Hij wordt gemaakt uit dezelfde
 * lijst waarmee de pagina haar secties zet, dus er is geen tweede lijst
 * die uit de pas kan lopen.
 *
 * Vanaf lg staat hij als vastgeplakte kolom naast de tekst. Daaronder
 * past geen kolom, dus daar staat hij als uitklapper boven de inhoud.
 * Het meelopen met wat je leest doet het script onderaan; zonder script
 * blijft het gewoon een rijtje links dat werkt.
 */
import { taalUitPad } from "../data/taal";
import { teksten } from "../data/teksten";

export type Opgave = { id: string; tekst: string };

interface Props {
  items: Opgave[];
}

const { items } = Astro.props;
const t = teksten[taalUitPad(Astro.url.pathname)];
---

{
  items.length > 2 && (
    <>
      {/* Vanaf lg: de kolom. top-24 houdt hem onder de kop, die blijft
          staan en 5 rem hoog is voor hij krimpt. */}
      <nav
        aria-labelledby="opgave-kop"
        data-opgave
        class="hidden lg:sticky lg:top-24 lg:block lg:self-start lg:py-24"
      >
        <p id="opgave-kop" class="label">
          {t.algemeen.opDezePagina}
        </p>
        <ol class="mt-4 space-y-1 border-l border-rand">
          {items.map((item, i) => (
            <li>
              <a
                href={`#${item.id}`}
                data-opgave-link={item.id}
                class="-ml-px flex gap-2 border-l border-transparent py-1.5 pl-4 text-sm text-zacht hover:border-rand hover:text-tekst"
              >
                <span aria-hidden="true" class="font-mono text-xs opacity-70">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <span class="min-w-0">{item.tekst}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>

      {/* Tot lg: dicht, want op een telefoon wil je eerst de kop zien. */}
      <details class="mt-8 rounded-kaart border border-rand bg-kaart lg:hidden">
        <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 px-4 label">
          {t.algemeen.opDezePagina}
          <span aria-hidden="true" class="text-zacht">
            +
          </span>
        </summary>
        <ol class="border-t border-rand/60 px-4 py-2">
          {items.map((item) => (
            <li>
              <a
                href={`#${item.id}`}
                class="flex min-h-11 items-center text-sm text-zacht hover:text-tekst"
              >
                {item.tekst}
              </a>
            </li>
          ))}
        </ol>
      </details>
    </>
  )
}

<style>
  summary::-webkit-details-marker {
    display: none;
  }
  details[open] > summary > span {
    transform: rotate(45deg);
  }
</style>

<script is:inline>
  /* Wachten tot de pagina geparseerd is: de opgave staat boven de secties
     waar hij naar wijst, dus die bestaan nog niet als dit script draait. */
  (() => {
    const start = () => {
      const opgave = document.querySelector("[data-opgave]");
      if (!opgave) return;

      const links = [...opgave.querySelectorAll("[data-opgave-link]")];

      const delen = links
        .map((link) => ({
          id: link.dataset.opgaveLink,
          sectie: document.getElementById(link.dataset.opgaveLink),
        }))
        .filter((deel) => deel.sectie);
      if (delen.length === 0) return;

      let huidig = null;
      const aan = (id) => {
        if (id === huidig) return;
        huidig = id;
        for (const link of links) {
          const actief = link.dataset.opgaveLink === id;
          /* Geen accent: dat is voor de knop en de focusring. De streep
             links krijgt de tekstkleur, de rest houdt de rand. */
          link.classList.toggle("border-tekst", actief);
          link.classList.toggle("text-tekst", actief);
          link.classList.toggle("text-zacht", !actief);
          if (actief) link.setAttribute("aria-current", "location");
          else link.removeAttribute("aria-current");
        }
      };

      /* Hier stond een IntersectionObserver die het hoogste deel koos
         dat in een band tussen de kop en 40% van het scherm viel. Tussen
         twee koppen in zit op een rustige pagina meer lucht dan die band
         hoog is, en dan valt er niets in: de opgave bleef hangen op het
         vorige deel terwijl de volgende kop al bovenaan stond.

         Nu is het een streep. Actief is het laatste deel dat die streep
         is gepasseerd, dus er is altijd precies één antwoord, ook als er
         geen kop in beeld is.

         De streep ligt op de scroll-margin-top van 6 rem uit global.css,
         met twee pixels speling voor het afronden. Dat is geen willekeurig
         getal: daar zet de browser een sectie neer als je een ankerlink
         volgt. Land je op #niveaus, dan staat niveaus precies op de
         streep en is hij actief. Elke andere waarde laat de opgave en de
         ankerlinks op het randje uit elkaar lopen. Daarom meet hij op de
         sectie en niet op de kop: het anker wijst ook naar de sectie. */
      const streep = 96 + 2;

      let bezig = false;
      const meten = () => {
        bezig = false;

        /* Onderaan de pagina kan de laatste kop de streep nooit meer
           halen, want er is niets meer om onder te schuiven. Dan hoort
           het laatste deel actief te zijn. */
        const onderaan =
          window.innerHeight + window.scrollY >=
          document.documentElement.scrollHeight - 2;
        if (onderaan) return aan(delen[delen.length - 1].id);

        let gekozen = delen[0];
        for (const deel of delen) {
          if (deel.sectie.getBoundingClientRect().top <= streep) gekozen = deel;
          else break;
        }
        aan(gekozen.id);
      };

      const plannen = () => {
        if (bezig) return;
        bezig = true;
        requestAnimationFrame(meten);
      };

      meten();
      window.addEventListener("scroll", plannen, { passive: true });
      window.addEventListener("resize", plannen);

      /* Nog drie keer opnieuw meten, want de eerste meting klopt vaak
         nog niet.

         Bij het laden van een adres met een anker erachter springt de
         browser pas naar die sectie nadat dit script is gedraaid, en dat
         springen levert niet altijd een scroll-gebeurtenis op. Dan stond
         01 aan terwijl 02 bovenaan de pagina stond. hashchange vangt
         hetzelfde als je later op een link in de opgave klikt.

         En de koppen staan in Manrope: tot dat font er is, meet je de
         hoogtes van het terugvalfont, en daarna staat alles ergens
         anders. De waarnemer vangt wat daarna nog schuift, zoals een
         afbeelding die binnenkomt. */
      window.addEventListener("load", plannen);
      window.addEventListener("hashchange", plannen);
      document.fonts?.ready.then(plannen);
      if ("ResizeObserver" in window) {
        new ResizeObserver(plannen).observe(document.body);
      }
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", start);
    } else {
      start();
    }
  })();
</script>
