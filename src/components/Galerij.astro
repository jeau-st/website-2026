---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

/**
 * De foto's bij elkaar, onder het verhaal. Kolommen in plaats van een
 * grid: dan houdt elke foto zijn eigen verhouding en hoeft er niets
 * weggesneden te worden. Geen onderschriften, de alt is voor wie de
 * foto niet ziet.
 */
interface Props {
  fotos: { src: ImageMetadata; alt: string }[];
}

const { fotos } = Astro.props;
---

<div class="mt-10 max-w-3xl gap-4 sm:columns-2">
  {
    fotos.map((foto) => (
      <Image
        src={foto.src}
        alt={foto.alt}
        widths={[400, 600, 800]}
        sizes="(min-width: 640px) 22rem, 100vw"
        class="mb-4 w-full break-inside-avoid border border-rand/60"
      />
    ))
  }
</div>
