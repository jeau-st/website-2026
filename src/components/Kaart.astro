---
/**
 * Een omlijnd vlak om inhoud die bij elkaar hoort. Dit verving de
 * afwisselende banen: alle secties staan nu op dezelfde achtergrond en
 * het groeperen gebeurt hier.
 *
 * De vulling is maar 1,1:1 lichter dan de achtergrond, dus de rand doet
 * het werk en de vulling geeft alleen diepte. De ronding is dezelfde 2 px
 * als de focusring, zodat een kaart met focus niet plotseling een andere
 * vorm heeft.
 *
 * `als` bestaat omdat een kaart soms een li in een lijst is en soms een
 * los blok. De opmaak blijft hetzelfde.
 */
interface Props {
  als?: "div" | "li" | "article" | "figure" | "details";
  id?: string;
  /** Krapper, voor een kaart in een raster van drie of meer. */
  krap?: boolean;
  class?: string;
}

const {
  als: Tag = "div",
  id,
  krap = false,
  class: extra = "",
} = Astro.props;
---

<Tag
  id={id}
  class:list={[
    "rounded-sm border border-rand bg-kaart",
    krap ? "p-5 sm:p-6" : "p-6 sm:p-8",
    extra,
  ]}
>
  <slot />
</Tag>
