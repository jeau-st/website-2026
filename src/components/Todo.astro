---
/**
 * Zichtbare markering voor inhoud die Joost nog moet invullen.
 * Opvallend met opzet: zo gaat er niets ongemerkt live.
 */
interface Props {
  wat: string;
}

const { wat } = Astro.props;
---

<p
  class="my-2 border border-dashed border-oker/70 bg-oker/10 px-3 py-2 font-mono text-sm text-oker"
>
  <span class="font-semibold">TODO</span>
  <span class="sr-only">, nog in te vullen:</span>
  {wat}
</p>
