---
import type { Pijnpunt } from "../data/site";

interface Props {
  punt: Pijnpunt;
}

const { punt } = Astro.props;
---

{/* Onder elkaar, dus de streep staat boven en niet links: drie smalle
    kolommen braken de citaten over drie regels en lazen daardoor traag. */}
<figure class="border-t border-rand pt-5">
  <blockquote>
    <p class="text-xl text-tekst">
      &ldquo;{punt.citaat}&rdquo;
    </p>
  </blockquote>
  <figcaption class="mt-2 max-w-2xl text-zacht">{punt.uitleg}</figcaption>
</figure>
