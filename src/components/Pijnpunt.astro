---
import Kaart from "./Kaart.astro";
import type { Pijnpunt } from "../data/site";

interface Props {
  punt: Pijnpunt;
}

const { punt } = Astro.props;
---

{/* Onder elkaar en niet in drie kolommen: smalle kolommen braken de
    citaten over drie regels en lazen daardoor traag. */}
<Kaart als="figure">
  <blockquote>
    <p class="text-xl text-tekst">
      &ldquo;{punt.citaat}&rdquo;
    </p>
  </blockquote>
  <figcaption class="mt-2 max-w-2xl text-zacht">{punt.uitleg}</figcaption>
</Kaart>
