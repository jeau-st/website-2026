---
import Kaart from "./Kaart.astro";
import Todo from "./Todo.astro";
import type { Vraag } from "../data/site";

/**
 * Een vraag met zijn antwoord, als uitklapper. De kaart is hier terecht:
 * je moet het ding kunnen indrukken.
 *
 * Het antwoord staat in `tekst` en niet in `zacht`. Dat heeft het wel
 * gedaan, en op een kaart haalde dat 4,5:1, precies de ondergrens.
 * Genoeg voor een labeltje van drie woorden, te mager voor vier regels
 * die je echt leest. Met de achtergrond was het niet op te lossen: tegen
 * puur zwart haalt `zacht` niet meer dan 5,44:1, dus dat plafond ligt te
 * laag. En het antwoord op een vraag is geen bijtekst maar de inhoud,
 * dus het hoort sowieso in dezelfde kleur als elke andere alinea.
 * Gemeten op de kaart: 16,1:1 in allebei de thema's.
 */

interface Props {
  item: Vraag;
}

const { item } = Astro.props;
---

<Kaart als="details" krap class="group">
  <summary
    class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 text-lg text-tekst hover:text-zacht"
  >
    {item.vraag}
    <span
      aria-hidden="true"
      class="shrink-0 text-zacht transition-transform duration-150 group-open:rotate-45"
    >
      +
    </span>
  </summary>
  {
    item.todo ? (
      <Todo wat={item.antwoord.replace(/^TODO:\s*/, "")} />
    ) : (
      <p class="mt-3 max-w-2xl text-tekst">{item.antwoord}</p>
    )
  }
</Kaart>
