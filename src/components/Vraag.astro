---
import Kaart from "./Kaart.astro";
import Todo from "./Todo.astro";
import type { Vraag } from "../data/site";

interface Props {
  item: Vraag;
}

const { item } = Astro.props;
---

<Kaart als="details" krap class="group">
  <summary
    class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 text-lg text-tekst hover:text-zacht"
  >
    {item.vraag}
    <span
      aria-hidden="true"
      class="shrink-0 text-zacht transition-transform duration-150 group-open:rotate-45"
    >
      +
    </span>
  </summary>
  {
    item.todo ? (
      <Todo wat={item.antwoord.replace(/^TODO:\s*/, "")} />
    ) : (
      <p class="mt-3 max-w-2xl text-zacht">{item.antwoord}</p>
    )
  }
</Kaart>
