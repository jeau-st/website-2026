---
import Basis from "../layouts/Basis.astro";
import Sectie from "../components/Sectie.astro";
import MetOpgave from "../components/MetOpgave.astro";
import Kaart from "../components/Kaart.astro";
import Knop from "../components/Knop.astro";
import AiStap from "../components/AiStap.astro";
import { aiStappen, pipedriveFuncties } from "../data/site";

/**
 * Pipedrive is geen dienst maar het product waarmee ik werk, dus deze
 * pagina staat naast /diensten en niet eronder. Hij bestaat omdat
 * "wat kan Pipedrive" de vraag is waarmee mensen zoeken, en omdat het
 * antwoord daarop nergens anders op de site stond.
 *
 * Geen abonnementen, geen prijzen en geen partnerschap. Zie
 * docs/brand-persona.md en SCHRIJFWIJZER.md.
 */
/* Een lijst voor de sectiekoppen en voor de inhoudsopgave tegelijk, zodat
   ze niet uit elkaar kunnen lopen. De afspraak onderaan staat er niet in. */
const delen = {
  functies: "Wat erin zit",
  ai: "Eerst de basis, dan AI",
  watikdoe: "Wat ik ermee doe",
};

const opgave = Object.entries(delen).map(([id, tekst]) => ({ id, tekst }));

const schema = {
  "@type": "WebPage",
  name: "Wat Pipedrive voor je team doet",
  about: {
    "@type": "SoftwareApplication",
    name: "Pipedrive",
    applicationCategory: "BusinessApplication",
  },
};
---

<Basis
  titel="Wat Pipedrive voor je team doet | Jeau.st"
  beschrijving="Mail, agenda, automatiseringen, projecten en rapportages in één systeem, en AI die je eigen klantgegevens kent. Uitgelegd door iemand die Pipedrive inricht."
  extraSchema={schema}
>
  <section class="px-4 py-20 sm:px-6 sm:py-24">
    <div class="mx-auto max-w-5xl">
      <p class="font-mono text-sm text-zacht">Pipedrive</p>
      <h1 class="mt-2 max-w-3xl text-4xl sm:text-5xl">
        Wat Pipedrive voor je team doet
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-zacht">
        Pipedrive is het CRM waarmee ik werk. Hieronder staat wat erin zit,
        in gewone woorden, zodat je kunt zien wat het je team oplevert
        voordat je ergens aan begint.
      </p>
    </div>
  </section>

  <MetOpgave items={opgave}>
  <Sectie id="functies" vol kop={delen.functies}>
    <dl class="mt-12 grid gap-4 md:grid-cols-2">
      {
        pipedriveFuncties.map((functie) => (
          <Kaart krap class="min-w-0">
            <dt class="text-lg text-kop">{functie.titel}</dt>
            <dd class="mt-2 min-w-0 text-zacht">{functie.tekst}</dd>
          </Kaart>
        ))
      }
    </dl>
    <p class="mt-12 max-w-2xl text-zacht">
      Dit hoeft niet allemaal aan. Welke hiervan je gebruikt, volgt uit je
      proces, en dat is precies de volgorde waarin ik werk.
    </p>
  </Sectie>

  <Sectie
    id="ai"
    vol
    kop={delen.ai}
    intro="AI is zo goed als de gegevens eronder. Staat je proces in een systeem en klopt wat erin staat, dan kun je er wat mee."
  >
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {aiStappen.map((stap) => <AiStap stap={stap} />)}
    </div>
    <p class="mt-12 max-w-2xl text-zacht">
      Een AI die het verkeerde antwoord geeft omdat een veld leeg was, is
      erger dan geen AI. Datakwaliteit hoort daarom in de inrichting te
      zitten: velden die verplicht zijn waar het telt, en afgeschermd waar
      niet iedereen ze hoort te wijzigen.
    </p>
  </Sectie>

  <Sectie id="watikdoe" vol kop={delen.watikdoe}>
    <div class="mt-8 max-w-2xl space-y-4 text-zacht">
      <p>
        Een systeem aanzetten is zo gebeurd. Het werk zit in de vraag hoe
        jullie verkopen, wat er daarna moet gebeuren en welke gegevens
        waarheen gaan. Daar richt ik Pipedrive op in, en daar hang ik je
        andere systemen aan.
      </p>
      <p>
        De afgelopen drie jaar deed ik drie volledige
        Pipedrive-implementaties, inclusief migraties en maatwerk.
      </p>
    </div>
    <ul class="mt-10 max-w-2xl space-y-3">
      <li>
        <a
          class="tekstlink inline-flex min-h-11 items-center text-tekst"
          href="/diensten/crm-inrichting/"
        >
          Zo richt ik Pipedrive in
        </a>
      </li>
      <li>
        <a
          class="tekstlink inline-flex min-h-11 items-center text-tekst"
          href="/diensten/koppelingen-en-automatisering/"
        >
          Zo koppel ik je andere systemen eraan
        </a>
      </li>
      <li>
        <a
          class="tekstlink inline-flex min-h-11 items-center text-tekst"
          href="/diensten/cijfers-en-ai/"
        >
          Zo komt er AI op je eigen cijfers
        </a>
      </li>
    </ul>
  </Sectie>

  </MetOpgave>

  <Sectie id="plannen">
    <div class="max-w-2xl">
      <h2 class="text-3xl sm:text-4xl">Past Pipedrive bij jouw proces?</h2>
      <p class="mt-4 text-lg text-zacht">
        Dat hoor je in een gesprek van 30 minuten. Past het niet, dan zeg ik
        dat ook.
      </p>
      <div class="mt-8">
        <Knop toonToelichting />
      </div>
    </div>
  </Sectie>
</Basis>
