---
import Basis from "../../layouts/Basis.astro";
import Sectie from "../../components/Sectie.astro";
import Knop from "../../components/Knop.astro";
import Todo from "../../components/Todo.astro";
import Kaart from "../../components/Kaart.astro";
import MetOpgave from "../../components/MetOpgave.astro";
import Kruimels, { kruimelSchema } from "../../components/Kruimels.astro";
import { bedrijf, diensten } from "../../data/site";

/**
 * Een eigen pagina per dienst. Dat is geen opmaakkeuze maar een
 * vindbaarheidskeuze: een zoekopdracht gaat over één onderwerp, en een
 * pagina die over vijf dingen gaat verliest het van een pagina die over
 * één ding gaat. Elke pagina heeft dus een eigen title, beschrijving en
 * Service-schema.
 *
 * Een dienst zonder verhaalblok heeft alleen de regel en de bullets uit
 * de lijst op de homepage. Dat is te weinig om op te ranken, dus die
 * pagina draagt een TODO tot Joost het aanvult. Zie OPLEVERING.md.
 */
export function getStaticPaths() {
  return diensten.map((dienst) => ({
    params: { slug: dienst.slug },
    props: { dienst },
  }));
}

const { dienst } = Astro.props;

const anderen = diensten.filter((item) => item.slug !== dienst.slug);

/* Een dienstpagina hangt onder /diensten. Dat staat nu boven de kop en
   in het schema, uit dezelfde lijst. */
const kruimels = [
  { tekst: "Jeau.st", href: "/" },
  { tekst: "Diensten", href: "/diensten" },
  { tekst: dienst.titel },
];

/* De inhoudsopgave volgt de secties van deze pagina: het lijstje met wat
   je krijgt, de verhaalblokken uit site.ts, en de verwijzing naar de rest.
   Een dienst zonder verhaal houdt er twee over, en dan laat de
   Inhoudsopgave zichzelf weg. */
const opgave = [
  { id: "watkrijgje", tekst: "Wat dat concreet is" },
  ...(dienst.verhaal ?? []).map((blok, i) => ({
    id: `hoe-${i + 1}`,
    tekst: blok.kop,
  })),
  { id: "verder", tekst: "De andere diensten" },
];

const schema = {
  "@type": "Service",
  name: dienst.titel,
  description: dienst.meta,
  serviceType: dienst.titel,
  provider: { "@id": `${Astro.site}#bedrijf` },
  areaServed: [
    { "@type": "City", name: bedrijf.plaats },
    { "@type": "Country", name: "Nederland" },
  ],
};
---

<Basis
  titel={`${dienst.kop} | Jeau.st`}
  beschrijving={dienst.meta}
  extraSchema={[schema, kruimelSchema(kruimels, Astro.site)]}
>
  <section class="px-4 py-20 sm:px-6 sm:py-24">
    <div class="mx-auto max-w-5xl">
      <Kruimels kruimels={kruimels} />
      <h1 class="mt-3 max-w-3xl text-4xl sm:text-5xl">{dienst.kop}</h1>
      <p class="mt-6 max-w-2xl text-lg text-zacht">{dienst.tekst}</p>
      {
        dienst.voorWie && (
          <p class="mt-4 max-w-2xl text-zacht">{dienst.voorWie}</p>
        )
      }
    </div>
  </section>

  <MetOpgave items={opgave}>
  <Sectie id="watkrijgje" vol kop="Wat dat concreet is">
    <Kaart class="mt-10 max-w-2xl">
    <ul class="divide-y divide-rand/60">
      {
        dienst.punten.map((punt) => (
          <li class="flex items-baseline gap-3 py-3 text-tekst">
            <span aria-hidden="true" class="font-mono text-sm text-zacht">
              &#8594;
            </span>
            <span class="min-w-0">{punt}</span>
          </li>
        ))
      }
    </ul>
    </Kaart>

    {
      !dienst.verhaal && (
        <div class="mt-10 max-w-2xl">
          <Todo
            wat={`vertel hier hoe ${dienst.titel.toLowerCase()} in de praktijk gaat: wat je tegenkomt, welke keuze jij maakt die een ander niet maakt, en wat mensen verkeerd verwachten. Zonder dat is deze pagina te dun om op te ranken.`}
          />
        </div>
      )
    }
  </Sectie>

  {
    dienst.verhaal?.map((blok, i) => (
      <Sectie id={`hoe-${i + 1}`} vol kop={blok.kop}>
        <div class="mt-8 max-w-2xl space-y-4 text-zacht">
          {blok.alineas.map((alinea) => (
            <p>{alinea}</p>
          ))}
        </div>
      </Sectie>
    ))
  }

  <Sectie id="verder" vol kop="De andere diensten">
    <ul class="mt-8 max-w-2xl space-y-3">
      {
        anderen.map((item) => (
          <li>
            <a
              class="tekstlink inline-flex min-h-11 items-center text-tekst"
              href={`/diensten/${item.slug}/`}
            >
              {item.titel}
            </a>
          </li>
        ))
      }
    </ul>
    <ul class="mt-8 max-w-2xl space-y-3 border-t border-rand/60 pt-6">
      <li>
        <a
          class="tekstlink inline-flex min-h-11 items-center text-tekst"
          href="/aanpak"
        >
          Lees hoe een traject verloopt
        </a>
      </li>
      <li>
        <a
          class="tekstlink inline-flex min-h-11 items-center text-tekst"
          href="/pipedrive"
        >
          Bekijk wat Pipedrive voor je team doet
        </a>
      </li>
    </ul>
  </Sectie>

  </MetOpgave>

  <Sectie id="plannen">
    <div class="max-w-2xl">
      <h2 class="text-3xl sm:text-4xl">Is dit wat je zoekt?</h2>
      <p class="mt-4 text-lg text-zacht">
        Vertel in een half uur wat er vastloopt. Ik zeg eerlijk of ik de
        juiste persoon ben.
      </p>
      <div class="mt-8">
        <Knop toonToelichting />
      </div>
    </div>
  </Sectie>
</Basis>
