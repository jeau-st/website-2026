---
import { Image } from "astro:assets";
import foto from "../assets/joost.webp";
import Basis from "../layouts/Basis.astro";
import Sectie from "../components/Sectie.astro";
import Knop from "../components/Knop.astro";
import AiStap from "../components/AiStap.astro";
import Pijnpunt from "../components/Pijnpunt.astro";
import Schema from "../components/Schema.astro";
import Dienst from "../components/Dienst.astro";
import Cyclus from "../components/Cyclus.astro";
import Stappenbalk from "../components/Stappenbalk.astro";
import Nastap from "../components/Nastap.astro";
import Vraag from "../components/Vraag.astro";
import {
  aiStappen,
  bedrijf,
  diensten,
  nabouw,
  pijnpunten,
  vragen,
  werkKort,
} from "../data/site";

/* Expres ongelijk van lengte en vorm. Vier punten met hetzelfde ritme
   lazen als een gegenereerd lijstje. Zie SCHRIJFWIJZER.md. */
const kernpunten = [
  "Je proces vastgelegd in Pipedrive, voor iedereen hetzelfde",
  "Eén bron van waarheid voor je hele team",
  "Koppelingen met de systemen die je al gebruikt",
  "Rapportages waar je op kunt sturen",
  "Een basis die strak genoeg is voor AI",
];
---

<Basis
  titel="Jeau.st: CRM, koppelingen en procesautomatisering"
  beschrijving="Joost Beers richt Pipedrive in, koppelt je systemen en automatiseert handwerk. Voor MKB en scale-ups die vastlopen in losse systemen en Excel."
>
  {/* Minder lucht boven de kop dan in de andere secties, zodat de kop, de
      zin eronder en de actie samen op 1280 bij 800 passen zonder scrollen. */}
  <section class="px-4 py-20 sm:px-6 sm:py-28 lg:pt-10">
    <div class="mx-auto max-w-5xl">
      <h1 class="max-w-3xl text-4xl sm:text-5xl lg:text-6xl">
        Dat doet Petra altijd
      </h1>
      {/* De kop zegt niet wat Jeau.st doet, dus de derde zin hieronder moet
          dat wel doen. Titel en meta description blijven expliciet, want
          daarop landt iemand vanuit Google. */}
      <p class="mt-6 max-w-2xl text-lg text-zacht">
        Tot Petra op vakantie is. Dan blijkt dat het proces alleen in haar
        hoofd zat. Ik zet het in een systeem waar je team mee werkt.
      </p>

      <Schema />

      <ul class="mt-8 max-w-2xl divide-y divide-rand/60 border-y border-rand/60">
        {
          kernpunten.map((punt) => (
            /* Het pijltje is versiering, niet de opsommingsmarkering: de ul
               geeft screenreaders die al. Daarom aria-hidden. */
            <li class="flex items-baseline gap-3 py-2 text-tekst">
              <span aria-hidden="true" class="font-mono text-sm text-zacht">
                &#8594;
              </span>
              <span class="min-w-0">{punt}</span>
            </li>
          ))
        }
      </ul>

      <div class="mt-8">
        <Knop toonToelichting />
      </div>
    </div>
  </section>

  <Sectie
    id="ai"
    vlak
    kop="Eerst de basis, dan AI"
    intro="AI is zo goed als de gegevens eronder. Staat je proces in een systeem en klopt wat erin staat, dan kun je er wat mee."
  >
    <div class="mt-12 grid gap-10 md:grid-cols-3">
      {aiStappen.map((stap) => <AiStap stap={stap} />)}
    </div>
  </Sectie>

  <Sectie
    id="herkenning"
    kop="Komt dit bekend voor?"
    intro="Drie dingen die ik bijna elk gesprek hoor."
  >
    <div class="mt-12 space-y-8">
      {pijnpunten.map((punt) => <Pijnpunt punt={punt} />)}
    </div>
  </Sectie>

  <Sectie
    id="volgorde"
    vlak
    kop="De volgorde is het werk"
    intro="In welke volgorde je dingen aanpakt, bepaalt of het werkt."
  >
    {/* De vier stappen stonden hier ook nog eens voluit, terwijl de
        tekening ze al noemt en /aanpak ze uitlegt. Hier dus alleen de
        tekening en het argument eronder. */}
    <Cyclus />
    <div class="mt-10 max-w-2xl space-y-4 text-zacht">
      <p>
        Eerst vastleggen hoe het nu echt gaat en daarna één manier van werken
        kiezen. Sla je die stap over, dan gaat de rommel straks alleen
        sneller. Automatiseren komt pas daarna, en alleen waar de meeste tijd
        in gaat zitten. Meten als laatste, want je verbetert alleen waar je
        zicht op hebt.
      </p>
      <p>
        Elk rondje is kleiner dan het vorige, want er is steeds minder te
        standaardiseren.
      </p>
    </div>
    <p class="mt-8">
      <a
        class="tekstlink inline-flex min-h-11 items-center text-tekst"
        href="/aanpak#volgorde"
      >
        Lees waarom de volgorde zo is
      </a>
    </p>
  </Sectie>

  <Sectie
    id="diensten"
    kop="Wat ik doe"
    intro="Dezelfde vier stappen, nu in wat er concreet gebouwd wordt."
  >
    <ol class="mt-12">
      {
        diensten.map((dienst, i) => (
          <Dienst dienst={dienst} nummer={String(i + 1).padStart(2, "0")} />
        ))
      }
    </ol>
  </Sectie>

  <Sectie
    id="proces"
    vlak
    kop="Hoe een traject loopt"
    intro="De volgorde hierboven is de denkwijze. Zo ziet een opdracht er in de praktijk uit."
  >
    <Stappenbalk />
    <p class="mt-10 text-zacht">
      <a class="tekstlink inline-flex min-h-11 items-center text-tekst" href="/aanpak">
        Lees wat er per stap gebeurt
      </a>
    </p>
  </Sectie>

  <Sectie
    id="daarna"
    kop="En dan gaat het pas werken"
    intro="De oplevering is het begin. Dit is het ritme daarna."
  >
    <div class="mt-12 grid gap-10 md:grid-cols-3">
      {nabouw.map((stap) => <Nastap stap={stap} />)}
    </div>
  </Sectie>

  <Sectie
    id="werk"
    vlak
    kop="Voorbeelden van werk"
    intro="Vier opdrachten, samengevat. Dit is wat er steeds terugkomt."
  >
    {/* De cases zelf staan op /werk. Ze hier ook voluit zetten maakte de
        homepage twee keer zo lang met dezelfde tekst. */}
    <dl class="mt-12 grid gap-10 md:grid-cols-3">
      {
        werkKort.map((deel) => (
          <div class="min-w-0 border-t border-rand/60 pt-5">
            <dt class="font-mono text-sm text-zacht">{deel.kop}</dt>
            <dd class="mt-3 min-w-0">
              <ul class="space-y-2">
                {deel.punten.map((punt) => (
                  <li class="flex items-baseline gap-3 text-tekst">
                    <span aria-hidden="true" class="font-mono text-sm text-zacht">
                      &#8594;
                    </span>
                    <span class="min-w-0">{punt}</span>
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        ))
      }
    </dl>
    <p class="mt-10">
      <a class="tekstlink inline-flex min-h-11 items-center text-tekst" href="/werk">
        Lees de vier cases uitgewerkt
      </a>
    </p>
  </Sectie>

  <Sectie id="over" kop="Over mij">
    <div class="mt-10">
      {/* Het hele kader, dus geen kolom ernaast: liggend naast tekst wordt
          de foto zo laag dat er een streepje van overblijft. Hij staat
          erboven op de breedte van de tekst. 896 px is het dubbele van de
          weergave, zodat hij op een scherm met hoge dichtheid scherp is. */}
      <Image
        src={foto}
        alt={`${bedrijf.persoon}, achter zijn bureau`}
        width={896}
        height={448}
        class="w-full max-w-md border border-rand/60"
      />

      <div class="mt-10 max-w-2xl">
        <p class="text-lg text-tekst">
          Ik ben {bedrijf.persoon}, koppelkoning en procesnerd uit {bedrijf.plaats}.
          Ik houd van systemen die met elkaar praten en van processen die
          kloppen omdat ze doordacht zijn, niet omdat ze altijd zo gingen.
        </p>
        <p class="mt-4 text-zacht">
          De afgelopen drie jaar deed ik drie volledige Pipedrive-implementaties,
          inclusief migraties en maatwerk. Daarvoor werkte ik zeven jaar bij
          een energieleverancier, in drie functies: Business Consultant IT,
          teamleider sales en data-analist. Hetzelfde systeem vanuit de bouw,
          het gebruik en de cijfers, en overal zag ik hetzelfde: wat
          ingewikkeld is, wordt niet gebruikt.
        </p>
        <p class="mt-4 text-zacht">
          Waar ik het voor doe: een klein bedrijf verdient net zo'n strak
          proces en net zulke goede systemen als een groot bedrijf, en
          inmiddels hoort daar ook AI bij. Bij een klein bedrijf zie ik
          bovendien meteen wat mijn werk oplevert.
        </p>
        <p class="mt-6">
          <a
            class="tekstlink inline-flex min-h-11 items-center text-tekst"
            href={bedrijf.linkedin}
            target="_blank"
            rel="noopener"
          >
            Laten we connecten op LinkedIn
          </a>
        </p>
      </div>
    </div>
  </Sectie>

  <Sectie id="vragen" vlak kop="Veelgestelde vragen">
    <div class="mt-10 max-w-3xl">
      {vragen.map((item) => <Vraag item={item} />)}
    </div>
  </Sectie>

  <Sectie id="plannen">
    <div class="max-w-2xl">
      <h2 class="text-3xl sm:text-4xl">
        Vertel eerst eens wat er vastloopt
      </h2>
      <p class="mt-4 text-lg text-zacht">
        Dertig minuten, via Teams. Ik vraag door en zeg eerlijk of ik de
        juiste persoon ben. Zo niet, dan weet ik vaak wel iemand.
      </p>
      <div class="mt-8">
        <Knop toonToelichting />
      </div>
    </div>
  </Sectie>
</Basis>
