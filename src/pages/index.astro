---
import { Image } from "astro:assets";
import foto from "../assets/joost.webp";
import Basis from "../layouts/Basis.astro";
import Naamwissel from "../components/Naamwissel.astro";
import Sectie from "../components/Sectie.astro";
import Knop from "../components/Knop.astro";
import Schema from "../components/Schema.astro";
import Icoon from "../components/Icoon.astro";
import Cyclus from "../components/Cyclus.astro";
import { kiesPersoon } from "../data/namen";
import Bouwstenen from "../components/Bouwstenen.astro";
import Kaart from "../components/Kaart.astro";
import {
  bedrijf,
  cases,
  diensten,
  inHetKort,
  kernpunten,
  pijnpunten,
} from "../data/site";
import Doorlink from "../components/Doorlink.astro";

/* De naam in de kop is niet vast: de build kiest er een, en Naamwissel
   kiest bij elk bezoek opnieuw. Zie src/data/namen.ts. */
const persoon = kiesPersoon();

/* De opdrachten die bij Resultaten op de homepage staan. Drie, want
   vier kolommen worden te smal en de rij moet op een regel passen. Ze
   komen uit dezelfde lijst als /werk, dus de homepage kan niets beloven
   wat daar niet uitgewerkt staat. */
const opHomepage = cases.filter((item) => !item.todo).slice(0, 3);

/**
 * Elk blok hieronder zegt kort iets en wijst door naar de pagina waar het
 * verhaal staat. Wat hier eerst voluit stond, staat nu op één plek: de
 * processtappen, het ritme na de oplevering en de veelgestelde vragen op
 * /aanpak, en de achtergrond op /over. Zie docs/structuurvoorstel.md.
 *
 * Wat AI met je eigen gegevens doet stond hier als eigen sectie. Het
 * hoort bij koppelingen en automatisering en staat daar op de
 * dienstpagina: een los blok op de homepage maakte er een onderwerp van
 * in plaats van een onderdeel.
 */
---

<Basis
  titel="Jeau.st - CRM en procesautomatisering voor mkb en scale-ups"
  beschrijving="Joost Beers richt Pipedrive in, koppelt je systemen en automatiseert handwerk. Voor mkb en scale-ups die vastlopen in losse systemen en Excel."
>
  {/* De hero staat in twee kolommen: links het verhaal en de vijf
      punten, rechts de tekening. Die stond eerst onder de tekst, in een
      kader, en dan is het een plaatje bij een stuk tekst. Ernaast en
      zonder kader is het de helft van de pagina, en dat is wat het moet
      zijn. Onder lg vallen ze terug op elkaar.

      Minder lucht boven de kop dan in de andere secties, zodat alles
      samen op 1280 bij 800 past zonder scrollen.

      Dezelfde max-w-5xl als elke andere sectie. Hij stond op 6xl, en
      daarmee begon de kop 64 px links van alles eronder: op een breed
      scherm zag je de hero uit de kantlijn lopen. De ring is daarop
      meegekrompen, zie Schema.astro.

      De twee kolommen waren gelijk, en dan past de langste naam niet op
      een regel: "Dat doet Sebastiaan altijd" is 554 px bij 48 px Manrope
      en de kolom was er 484. De tekst krijgt nu 61 procent en de ring
      39, en de ring is daarop meegekrompen. Zie Schema.astro. */}
  <section class="px-4 py-14 sm:px-6 sm:py-16 lg:pb-14 lg:pt-10">
    <div
      class="mx-auto grid max-w-5xl items-center gap-10 lg:grid-cols-[minmax(0,0.6fr)_minmax(0,0.4fr)] lg:gap-10"
    >
      <div>
        {/* De naam draagt het accent, want hij is een actie: klikken geeft
            een andere naam. Een knop en geen span, zodat je er met het
            toetsenbord bij komt. */}
        <h1 class="text-4xl sm:text-5xl">
          Dat doet <button
            type="button"
            data-wisselknop
            title="Kies een andere naam"
            class="cursor-pointer text-accent underline decoration-transparent decoration-1 underline-offset-4 hover:decoration-current"
          ><span data-naam>{persoon.naam}</span></button> altijd
        </h1>
        {/* De kop zegt niet wat Jeau.st doet, dus de zinnen daaronder
            moeten dat wel doen. Titel en meta description blijven
            expliciet, want daarop landt iemand vanuit Google.

            Eén alinea en niet twee: het probleem en wat ik eraan doe
            horen bij elkaar, en met een witregel ertussen las het tweede
            stuk als een losse slogan. */}
        <p class="mt-5 text-lg text-tekst">
          Tot <span data-naam>{persoon.naam}</span> op vakantie is. Dan blijkt
          dat het proces alleen in{" "}
          <span data-bezittelijk>{persoon.bezittelijk}</span> hoofd zat. Ik
          zorg voor een systeem dat werkt voor je hele team. En een goede
          basis voor jouw AI-ambities.
        </p>

        <Naamwissel />

        {/* Geen kader en geen pijltjes: een vinkje in de accentkleur. Dat
            is de vierde plek waar het accent mag staan, naast de knop, de
            focusring en de naam hierboven, en CLAUDE.md zegt dat ook zo.
            Het vinkje is versiering, de ul geeft screenreaders de
            opsomming al, dus aria-hidden. */}
        <ul class="mt-8 space-y-2.5">
          {
            kernpunten.map((punt) => (
              <li class="flex items-start gap-3 text-tekst">
                <svg
                  class="mt-1 size-4 shrink-0 text-accent"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <Icoon naam="check" maat={24} dikte={2.5} />
                </svg>
                <span class="min-w-0">{punt}</span>
              </li>
            ))
          }
        </ul>

        <div class="mt-8">
          <Knop toonToelichting />
        </div>
      </div>

      <Schema />
    </div>
  </section>

  {/* De samenvatting staat tegen de hero aan en niet verderop: dit is de
      regel die de rest van de pagina uitlegt. Een haarlijnraster en geen
      zes kaarten, want zes losse vlakken naast elkaar wegen alle zes
      hetzelfde en dan is het een blokkenschema. */}
  <Sectie id="kort" kop="In het kort" aansluitend>
    {/* Haarlijnen, geen vlakken. Dit is tekst die je leest, en een rand
        eromheen maakt er zes kaartjes van die je zou kunnen indrukken.

        Alleen de eerste cel van een rij staat tegen de kantlijn, de rest
        houdt 24 px van de haarlijn af. Welke cel dat is, hangt af van
        het aantal kolommen, en dat verschilt per breekpunt.

        Dat stond eerst als `pl-6` met een `nth-child`-uitzondering voor
        de eerste kolom. Die uitzondering gold vanaf sm en bleef dus ook
        bij lg staan, en omdat een regel met `nth-child` zwaarder weegt
        dan `lg:pl-6` wonnen de twee kolommen van sm het van de drie van
        lg: cel 3 en 5 kropen 24 px naar links en de kolommen lijnden
        per rij anders uit.

        Nu rekent de pagina het zelf uit. De index is hier bekend, dus
        per cel staat er gewoon of ze de eerste van haar rij is, en in
        de css staan alleen gewone klassen die elkaar netjes in volgorde
        overschrijven. */}
    <dl class="mt-10 grid gap-px bg-rand-zacht sm:grid-cols-2 lg:grid-cols-3">
      {
        inHetKort.map((regel, i) => (
          <div
            class:list={[
              "min-w-0 bg-bg py-5 sm:py-6 sm:pr-6",
              i % 2 !== 0 && "sm:pl-6",
              i % 3 === 0 ? "lg:pl-0" : "lg:pl-6",
            ]}
          >
            <dt class="label">{regel.vraag}</dt>
            <dd class="mt-2 min-w-0 text-tekst">{regel.antwoord}</dd>
          </div>
        ))
      }
    </dl>
  </Sectie>

  <Sectie id="herkenning" kop="Komt dit bekend voor?">
    {/* De intro staat in de eerste kolom en niet boven de kop, zodat de
        vier kolommen op één regel beginnen: eerst wat je gaat lezen, dan
        de drie citaten. Geen kaarten eromheen, alleen de haarlijn
        ertussen. Daarom staan de cellen op de achtergrondkleur en niet op
        de kaartkleur: met een vlak eronder wordt het alsnog een blok. */}
    <div class="mt-10 grid gap-px bg-rand-zacht md:grid-cols-4">
      <p class="bg-bg pb-6 text-zacht md:pb-0 md:pr-6">
        Drie dingen die ik bijna elk gesprek hoor.
      </p>
      {
        pijnpunten.map((punt) => (
          <figure class="min-w-0 bg-bg py-6 md:px-6 md:py-0">
            <blockquote>
              <p class="font-titel text-lg font-semibold text-kop">
                &ldquo;{punt.citaat}&rdquo;
              </p>
            </blockquote>
            <figcaption class="mt-3 text-sm text-zacht">{punt.uitleg}</figcaption>
          </figure>
        ))
      }
    </div>
  </Sectie>

  <Sectie
    id="volgorde"
    gecentreerd
    kop="De volgorde is het werk"
    intro="Eerst vastleggen hoe het nu echt gaat, dan één manier van werken kiezen. Automatiseren komt daarna, en meten als laatste."
  >
    {/* De tekening noemt de vier stappen al en /aanpak legt ze uit, dus
        hier staan ze niet ook nog eens voluit. */}
    <Cyclus />
    <p class="mt-10">
      <Doorlink href="/aanpak#volgorde">Lees waarom de volgorde zo is</Doorlink>
    </p>
  </Sectie>

  <Sectie
    id="diensten"
    kop="Wat ik doe"
    intro="Vijf soorten werk. De eerste vier volgen de volgorde waarin ik ze aanpak."
  >
    {/* Eén blok per dienst, en het hele blok is de link. Dit was één
        band van vijf cellen, en dan leest het als één ding met vijf
        regels: je ziet niet dat je er vijf kanten op kunt. Een kaart is
        er volgens CLAUDE.md voor iets dat je aanwijst of indrukt, en dat
        is hier zo. Aanwijzen maakt het vlak een stap lichter, want op
        een telefoon bestaat hover niet en moet `drukbaar` het doen.

        Vijf naast elkaar vanaf lg, zodat de vijf soorten werk één rij
        zijn en je ze in één blik overziet. Een kolom is dan 192 px, dus
        de ruimte eromheen is krap en de tussenruimte klein. De volle
        uitleg staat op de dienstpagina, hier staat per soort één
        regel. */}
    <ol class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-5 lg:gap-3">
      {
        diensten.map((dienst, i) => (
          <Kaart
            als="li"
            krap
            class="group drukbaar relative p-5 transition-colors hover:bg-kaart-hover sm:p-5"
          >
            <p class="label" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </p>
            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
              class="mt-4 size-5 text-zacht transition-colors group-hover:text-kop"
            >
              <Icoon naam={dienst.icoon} maat={24} />
            </svg>
            {/* De link rekt zich over het hele blok uit, want als los
                stukje tekst is hij op een telefoon te klein om te raken.
                Geen onderstreping: het hele blok is de link, en dan wijst
                een streepje onder de titel naar iets kleiners dan wat je
                aanklikt. Dat het een link is, zie je aan het vlak dat
                oplicht. */}
            <h3 class="mt-3 text-base">
              <a class="after:absolute after:inset-0" href={`/diensten/${dienst.slug}/`}>
                {dienst.titel}
              </a>
            </h3>
            <p class="mt-1.5 text-sm text-zacht">{dienst.kort}</p>
          </Kaart>
        ))
      }
    </ol>
    <p class="mt-10">
      <Doorlink href="/diensten">Bekijk alle diensten</Doorlink>
    </p>
  </Sectie>

  <Sectie
    id="werk"
    kop="Resultaten"
    intro="Drie opdrachten, en wat er na de oplevering anders is. De iconen zijn de onderdelen uit de ring hierboven die zijn aangepakt."
  >
    {/* Geen kaarten: drie kolommen met een haarlijn ertussen. Wat hier
        staat lees je, dus het hoeft geen vlak om zich heen.

        Per opdracht één tekstje. Hier stonden de eerste drie punten uit
        het resultaat op /werk, en drie kolommen met elk drie bullets
        lazen als een opsomming van opsommingen. Het tekstje staat als
        `opbrengst` bij de opdracht zelf, dus de homepage belooft nog
        steeds niets wat op /werk niet uitgewerkt staat. */}
    <ul class="mt-10 grid gap-px bg-rand-zacht md:grid-cols-3">
      {
        opHomepage.map((opdracht) => (
          <li class="min-w-0 bg-bg py-6 md:px-6 md:py-0 md:first:pl-0">
            <p class="label">{opdracht.kort}</p>
            <Bouwstenen namen={opdracht.bouwstenen} maat={8} class="mt-3" />
            <p class="mt-4 min-w-0 text-tekst">{opdracht.opbrengst}</p>
          </li>
        ))
      }
    </ul>
    <p class="mt-10">
      <Doorlink href="/werk">Lees de opdrachten uitgewerkt</Doorlink>
    </p>
  </Sectie>

  {/* "Over mij" heette dit, en de tekst eronder ging over één persoon.
      Komt er iemand bij, dan klopt dat niet meer en zou de site mee
      moeten veranderen. Het gaat nu over Jeau.st, met Joost erin. */}
  <Sectie id="over" kop="Over Jeau.st">
    <div class="mt-10">
      {/* Het hele kader, dus geen kolom ernaast: liggend naast tekst wordt
          de foto zo laag dat er een streepje van overblijft. Hij staat
          erboven op de breedte van de tekst. 896 px is het dubbele van de
          weergave, zodat hij op een scherm met hoge dichtheid scherp is. */}
      <Image
        src={foto}
        alt={`${bedrijf.persoon}, achter zijn bureau`}
        width={896}
        height={448}
        class="w-full max-w-lg rounded-groot border border-rand/60"
      />

      <div class="mt-10 max-w-2xl">
        <p class="text-lg text-tekst">
          Jeau.st zit in {bedrijf.plaats}, bij {bedrijf.onderdeelVan}. Achter
          de naam staat {bedrijf.persoon}, koppelkoning en procesnerd, met
          tien jaar ervaring in salesteams, data-analyse,
          systeemimplementaties en koppelingen.
        </p>
        <p class="mt-6">
          <Doorlink href="/over">Lees waar die ervaring vandaan komt</Doorlink>
        </p>
      </div>
    </div>
  </Sectie>

  <Sectie id="plannen">
    <div class="max-w-2xl">
      <h2 class="text-3xl sm:text-4xl">
        Vertel eerst eens wat er vastloopt
      </h2>
      <p class="mt-4 text-lg text-zacht">
        Dertig minuten, via Teams. Ik vraag door en zeg eerlijk of ik de
        juiste persoon ben. Zo niet, dan weet ik vaak wel iemand.
      </p>
      <div class="mt-8">
        <Knop toonToelichting />
      </div>
    </div>
  </Sectie>
</Basis>
