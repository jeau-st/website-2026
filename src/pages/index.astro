---
import { Image } from "astro:assets";
import foto from "../assets/joost.webp";
import Basis from "../layouts/Basis.astro";
import Naamwissel from "../components/Naamwissel.astro";
import Sectie from "../components/Sectie.astro";
import Kaart from "../components/Kaart.astro";
import Knop from "../components/Knop.astro";
import Pijnpunt from "../components/Pijnpunt.astro";
import Schema from "../components/Schema.astro";
import Dienst from "../components/Dienst.astro";
import Cyclus from "../components/Cyclus.astro";
import { kiesPersoon } from "../data/namen";
import { bedrijf, diensten, pijnpunten, werkKort } from "../data/site";

/* De naam in de kop is niet vast: de build kiest er een, en Naamwissel
   kiest bij elk bezoek opnieuw. Zie src/data/namen.ts. */
const persoon = kiesPersoon();

/* Expres ongelijk van lengte en vorm. Vier punten met hetzelfde ritme
   lazen als een gegenereerd lijstje. Zie SCHRIJFWIJZER.md. */
const kernpunten = [
  "Je proces vastgelegd in Pipedrive, voor iedereen hetzelfde",
  "Eén bron van waarheid voor je hele team",
  "Koppelingen met de systemen die je al gebruikt",
  "Rapportages waar je op kunt sturen",
  "Een basis die strak genoeg is voor AI",
];

/**
 * Elk blok hieronder zegt kort iets en wijst door naar de pagina waar het
 * verhaal staat. Wat hier eerst voluit stond, staat nu op één plek: de
 * processtappen, het ritme na de oplevering en de veelgestelde vragen op
 * /aanpak, waar dit het beste werkt op /diensten, en de achtergrond op
 * /over. Zie docs/structuurvoorstel.md.
 */
---

<Basis
  titel="Jeau.st: CRM, koppelingen en procesautomatisering"
  beschrijving="Joost Beers richt Pipedrive in, koppelt je systemen en automatiseert handwerk. Voor mkb en scale-ups met lange projecten, die vastlopen in losse systemen en Excel."
>
  {/* Minder lucht boven de kop dan in de andere secties, zodat de kop, de
      zin eronder en de actie samen op 1280 bij 800 passen zonder scrollen. */}
  <section class="px-4 py-16 sm:px-6 sm:py-20 lg:pb-10 lg:pt-8">
    <div class="mx-auto max-w-5xl">
      {/* De naam draagt het accent, want hij is een actie: klikken geeft
          een andere naam. Dat is de enige plek buiten de primaire knop,
          de focusring en het woordmerk waar die kleur mag staan, en
          CLAUDE.md zegt dat ook zo. Een knop en geen span, zodat je er
          met het toetsenbord bij komt. */}
      <h1 class="max-w-3xl text-4xl sm:text-5xl lg:text-6xl">
        Dat doet <button
          type="button"
          data-wisselknop
          title="Kies een andere naam"
          class="cursor-pointer text-accent underline decoration-transparent decoration-1 underline-offset-4 hover:decoration-current"
        ><span data-naam>{persoon.naam}</span></button> altijd
      </h1>
      {/* De kop zegt niet wat Jeau.st doet, dus de derde zin hieronder moet
          dat wel doen. Titel en meta description blijven expliciet, want
          daarop landt iemand vanuit Google. */}
      <p class="mt-5 max-w-2xl text-lg text-zacht">
        Tot <span data-naam>{persoon.naam}</span> op vakantie is. Dan blijkt
        dat het proces alleen in{" "}
        <span data-bezittelijk>{persoon.bezittelijk}</span> hoofd zat. Ik zet
        het in een systeem waar je team mee werkt.
      </p>

      <Naamwissel />

      <Schema />

      {/* Krap, en met minder lucht erboven dan elders: anders past de
          hero niet meer op 1280 bij 800 zonder scrollen. */}
      <Kaart krap class="mt-5 max-w-2xl">
      <ul class="divide-y divide-rand/60">
        {
          kernpunten.map((punt) => (
            /* Het pijltje is versiering, niet de opsommingsmarkering: de ul
               geeft screenreaders die al. Daarom aria-hidden. */
            <li class="flex items-baseline gap-3 py-2 text-tekst">
              <span aria-hidden="true" class="font-mono text-sm text-zacht">
                &#8594;
              </span>
              <span class="min-w-0">{punt}</span>
            </li>
          ))
        }
      </ul>
      </Kaart>

      <div class="mt-6">
        <Knop toonToelichting />
      </div>
    </div>
  </section>

  <Sectie
    id="ai"
    kop="Eerst de basis, dan AI"
    intro="AI is zo goed als de gegevens eronder. Staat je proces in een systeem en klopt wat erin staat, dan kun je er wat mee."
  >
    <div class="mt-8 max-w-2xl text-zacht">
      <p>
        Dat gaat op drie manieren: de AI die in je CRM zelf zit, je eigen AI
        die rechtstreeks aan je cijfers mag, en de koppelingen waardoor je
        systemen elkaar op de hoogte houden.
      </p>
    </div>
    <p class="mt-8">
      <a
        class="tekstlink inline-flex min-h-11 items-center text-tekst"
        href="/pipedrive#ai"
      >
        Lees wat AI met je eigen gegevens doet
      </a>
    </p>
  </Sectie>

  <Sectie
    id="herkenning"
    kop="Komt dit bekend voor?"
    intro="Drie dingen die ik bijna elk gesprek hoor."
  >
    <div class="mt-12 space-y-8">
      {pijnpunten.map((punt) => <Pijnpunt punt={punt} />)}
    </div>
  </Sectie>

  <Sectie
    id="volgorde"
    kop="De volgorde is het werk"
    intro="Eerst vastleggen hoe het nu echt gaat, dan één manier van werken kiezen. Automatiseren komt daarna, en meten als laatste."
  >
    {/* De tekening noemt de vier stappen al en /aanpak legt ze uit, dus
        hier staan ze niet ook nog eens voluit. */}
    <Cyclus />
    <p class="mt-10">
      <a
        class="tekstlink inline-flex min-h-11 items-center text-tekst"
        href="/aanpak#volgorde"
      >
        Lees waarom de volgorde zo is
      </a>
    </p>
  </Sectie>

  <Sectie
    id="diensten"
    kop="Wat ik doe"
    intro="Vijf soorten werk. De eerste vier volgen de volgorde waarin ik ze aanpak."
  >
    <ol class="mt-12 space-y-4">
      {
        diensten.map((dienst, i) => (
          <Dienst dienst={dienst} nummer={String(i + 1).padStart(2, "0")} />
        ))
      }
    </ol>
    <p class="mt-10">
      <a
        class="tekstlink inline-flex min-h-11 items-center text-tekst"
        href="/diensten"
      >
        Bekijk alle diensten
      </a>
    </p>
  </Sectie>

  <Sectie
    id="werk"
    kop="Voorbeelden van werk"
    intro="Vier opdrachten, samengevat. Dit is wat er steeds terugkomt."
  >
    {/* De cases zelf staan op /werk. Ze hier ook voluit zetten maakte de
        homepage twee keer zo lang met dezelfde tekst. */}
    <dl class="mt-12 grid gap-6 md:grid-cols-3">
      {
        werkKort.map((deel) => (
          <Kaart krap class="min-w-0">
            <dt class="font-mono text-sm text-zacht">{deel.kop}</dt>
            <dd class="mt-3 min-w-0">
              <ul class="space-y-2">
                {deel.punten.map((punt) => (
                  <li class="flex items-baseline gap-3 text-tekst">
                    <span aria-hidden="true" class="font-mono text-sm text-zacht">
                      &#8594;
                    </span>
                    <span class="min-w-0">{punt}</span>
                  </li>
                ))}
              </ul>
            </dd>
          </Kaart>
        ))
      }
    </dl>
    <p class="mt-10">
      <a class="tekstlink inline-flex min-h-11 items-center text-tekst" href="/werk">
        Lees de vier cases uitgewerkt
      </a>
    </p>
  </Sectie>

  <Sectie id="over" kop="Wie dit doet">
    <div class="mt-10">
      {/* Het hele kader, dus geen kolom ernaast: liggend naast tekst wordt
          de foto zo laag dat er een streepje van overblijft. Hij staat
          erboven op de breedte van de tekst. 896 px is het dubbele van de
          weergave, zodat hij op een scherm met hoge dichtheid scherp is. */}
      <Image
        src={foto}
        alt={`${bedrijf.persoon}, achter zijn bureau`}
        width={896}
        height={448}
        class="w-full max-w-md border border-rand/60"
      />

      <div class="mt-10 max-w-2xl">
        <p class="text-lg text-tekst">
          Ik ben {bedrijf.persoon}, koppelkoning en procesnerd uit {bedrijf.plaats}.
          Drie jaar Pipedrive-implementaties, daarvoor zeven jaar Business
          Consultant IT bij een energieleverancier.
        </p>
        <p class="mt-6">
          <a
            class="tekstlink inline-flex min-h-11 items-center text-tekst"
            href="/over"
          >
            Lees waar ik het heb geleerd
          </a>
        </p>
      </div>
    </div>
  </Sectie>

  <Sectie id="plannen">
    <div class="max-w-2xl">
      <h2 class="text-3xl sm:text-4xl">
        Vertel eerst eens wat er vastloopt
      </h2>
      <p class="mt-4 text-lg text-zacht">
        Dertig minuten, via Teams. Ik vraag door en zeg eerlijk of ik de
        juiste persoon ben. Zo niet, dan weet ik vaak wel iemand.
      </p>
      <div class="mt-8">
        <Knop toonToelichting />
      </div>
    </div>
  </Sectie>
</Basis>
