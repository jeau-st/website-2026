---
import Basis from "../layouts/Basis.astro";
---

<Basis titel="Jeau.st" beschrijving="Nieuwe website voor Jeau.st, in opbouw.">
  <main class="mx-auto flex min-h-screen max-w-2xl flex-col justify-center px-4 py-16">
    <p class="font-mono text-sm tracking-wide text-pigment">Jeau.st</p>
    <h1 class="mt-4 text-4xl font-semibold text-slate sm:text-5xl">
      Nieuwe site, in opbouw
    </h1>
    <p class="mt-6 text-lg text-pigment">
      De techniek staat klaar. De inhoud volgt.
    </p>
  </main>
</Basis>
