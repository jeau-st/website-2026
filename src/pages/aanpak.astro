---
import Basis from "../layouts/Basis.astro";
import Sectie from "../components/Sectie.astro";
import MetOpgave from "../components/MetOpgave.astro";
import Knop from "../components/Knop.astro";
import Denkstap from "../components/Denkstap.astro";
import Cyclus from "../components/Cyclus.astro";
import Niveau from "../components/Niveau.astro";
import Stappentabel from "../components/Stappentabel.astro";
import Vraag from "../components/Vraag.astro";
import { denkwijze, nabouw, niveaus, vragen } from "../data/site";
import Doorlink from "../components/Doorlink.astro";

/**
 * De vragen stonden op de homepage. Ze gaan bijna allemaal over hoe een
 * traject loopt, dus ze horen hier, bij de stappen en bij het ritme na de
 * oplevering. Het FAQPage-schema verhuist mee: dat hoort op de pagina waar
 * het antwoord staat.
 *
 * Alleen vrijgegeven vragen in het schema: een TODO als antwoord aanbieden
 * aan Google is erger dan de vraag weglaten.
 */
/**
 * De secties van deze pagina, met de tekst die in de inhoudsopgave komt.
 * Een lijst, gebruikt voor allebei: de kop van de sectie en de regel in
 * de opgave. Zo kunnen ze niet uit elkaar lopen. De afspraak onderaan
 * staat er niet in, want een inhoudsopgave wijst naar inhoud.
 */
const delen = {
  volgorde: "De vier stappen",
  niveaus: "Waar sta jij?",
  stappen: "Zo loopt een opdracht",
  daarna: "Betrokkenheid na livegang",
  werkwijze: "Hoe ik werk",
  vragen: "Veelgestelde vragen",
};

/* De vier stellingen onder "Hoe ik werk". Ze staan hier en niet in
   site.ts, want ze komen nergens anders terug. Expres ongelijk van
   lengte: de laatste is één zin, en dat mag. */
const werkwijzePunten = [
  {
    kop: "Als niemand behalve ik het begrijpt, is het te slim gebouwd",
    tekst:
      "De simpelste versie die werkt, wint. Slim bouwen mag, maar alleen waar het echt iets scheelt. Want een constructie die alleen ik kan onderhouden, maakt je afhankelijk van mij. Dat wil je niet en ik ook niet.",
  },
  {
    kop: "Je praat met de persoon die het bouwt",
    tekst:
      "Dezelfde persoon zit aan tafel bij het eerste gesprek en bij de oplevering.",
  },
  {
    kop: "Het team beslist of het werkt",
    tekst:
      "Een systeem dat niemand gebruikt, is weggegooid geld. Daarom spreek ik de mensen die ermee gaan werken al tijdens de analyse, en hoort training bij het werk in plaats van erna.",
  },
  {
    kop: "Liever volgende maand iets dat werkt",
    tekst: "Dan een plan dat over een jaar af is.",
  },
];

const opgave = Object.entries(delen).map(([id, tekst]) => ({ id, tekst }));

/* Hetzelfde nummer in de kantlijn als in de inhoudsopgave, afgeleid uit
   dezelfde lijst, zodat de twee niet uit elkaar kunnen lopen. */
const nr = Object.fromEntries(Object.keys(delen).map((id, i) => [id, i + 1]));

const faqSchema = {
  "@type": "FAQPage",
  mainEntity: vragen
    .filter((item) => !item.todo)
    .map((item) => ({
      "@type": "Question",
      name: item.vraag,
      acceptedAnswer: { "@type": "Answer", text: item.antwoord },
    })),
};
---

<Basis
  titel="Aanpak: eerst het proces, dan automatiseren | Jeau.st"
  beschrijving="Eerst het proces vastleggen en standaardiseren, dan automatiseren waar de meeste tijd in gaat zitten, dan meetbaar maken. En dan opnieuw."
  extraSchema={faqSchema}
>
  <section class="px-4 py-20 sm:px-6 sm:py-24">
    <div class="mx-auto max-w-5xl">
      <h1 class="max-w-3xl text-4xl sm:text-5xl lg:text-6xl">
        Eerst het proces, dan de techniek
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-zacht">
        Automatiseren is niet moeilijk. Het moeilijke is weten wat je moet
        automatiseren. Daarom gaat het bij mij altijd in dezelfde vier stappen,
        en is de laatste stap om terug te gaan naar de eerste.
      </p>
    </div>
  </section>

  <MetOpgave items={opgave}>
  <Sectie id="volgorde" vol nummer={nr.volgorde} kop={delen.volgorde}>
    <ol class="mt-10 grid gap-px bg-rand-zacht">
      {denkwijze.map((stap) => <Denkstap stap={stap} />)}
    </ol>
    <Cyclus />
  </Sectie>

  <Sectie
    id="niveaus"
    vol
    nummer={nr.niveaus}
    kop={delen.niveaus}
    intro="Niet iedereen begint bij 01. Lees deze vier door en kijk welke het meest op jouw bedrijf lijkt."
  >
    <ol class="mt-12 space-y-4">
      {niveaus.map((niveau) => <Niveau niveau={niveau} />)}
    </ol>
    <p class="max-w-2xl border-t border-rand/60 pt-8 text-zacht">
      Zit je ertussenin, dan is dat normaal. Verkoop staat vaak op een ander
      niveau dan de administratie.
    </p>
  </Sectie>

  <Sectie
    id="stappen"
    vol
    nummer={nr.stappen}
    kop={delen.stappen}
    intro="De vier stappen hierboven zijn de denkwijze. Hieronder staat hoe dat in de praktijk verloopt, met per stap wat ik doe, wat jij doet en wat er aan het eind ligt."
  >
    <Stappentabel />
  </Sectie>

  <Sectie
    id="daarna"
    vol
    nummer={nr.daarna}
    kop={delen.daarna}
    intro="De oplevering is het begin. Dit is het ritme daarna."
  >
    {/* Twee korte alinea's naast elkaar. Ze stonden in een kader van
        max-w-xl, en dan is het kader breder dan wat erin staat. */}
    <div class="mt-10 grid gap-px bg-rand-zacht md:grid-cols-2">
      {
        nabouw.map((stap) => (
          <div class="bg-bg py-6 md:px-6 md:py-0 md:first:pl-0">
            <h3 class="text-lg">{stap.titel}</h3>
            <p class="mt-2 text-zacht">{stap.tekst}</p>
          </div>
        ))
      }
    </div>
    <p class="mt-10">
      <Doorlink href="/diensten/ondersteuning-en-training/">Lees wat ondersteuning en training inhoudt</Doorlink>
    </p>
  </Sectie>

  {/* Dit stond eerst als raster van vier gelijke blokjes, daarna als
      vier kaarten onder elkaar. Allebei fout: dit zijn stellingen en geen
      objecten. Je kiest er niets uit, je leest ze achter elkaar. Dus
      alleen een haarlijn tussen de een en de ander, en de lengte die ze
      nodig hebben. */}
  <Sectie id="werkwijze" vol nummer={nr.werkwijze} kop={delen.werkwijze}>
    <div class="mt-10 grid max-w-2xl gap-px bg-rand-zacht">
      {
        werkwijzePunten.map((punt) => (
          <div class="bg-bg py-6 first:pt-0 last:pb-0">
            <h3 class="text-lg">{punt.kop}</h3>
            <p class="mt-2 text-zacht">{punt.tekst}</p>
          </div>
        ))
      }
    </div>
  </Sectie>

  <Sectie id="vragen" vol nummer={nr.vragen} kop={delen.vragen}>
    <div class="mt-10 max-w-3xl space-y-3">
      {vragen.map((item) => <Vraag item={item} />)}
    </div>
  </Sectie>

  </MetOpgave>

  <Sectie id="plannen">
    <div class="max-w-2xl">
      <h2 class="text-3xl sm:text-4xl">
        Waar jouw rondje begint, weet ik nog niet
      </h2>
      <p class="mt-4 text-lg text-zacht">
        Dat hoor ik in een gesprek van 30 minuten. Daarna weet je of het zin
        heeft om verder te praten.
      </p>
      <div class="mt-8">
        <Knop toonToelichting />
      </div>
    </div>
  </Sectie>
</Basis>
