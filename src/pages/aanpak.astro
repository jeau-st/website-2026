---
import Basis from "../layouts/Basis.astro";
import Sectie from "../components/Sectie.astro";
import Knop from "../components/Knop.astro";
import Processtap from "../components/Processtap.astro";
import { processtappen } from "../data/site";
---

<Basis
  titel="Aanpak: zo loopt een traject | Jeau.st"
  beschrijving="Van kennismaking tot doorlopende support. Zes stappen, met per stap wat ik doe, wat jij doet en wat er aan het eind ligt."
>
  <section class="px-4 py-20 sm:px-6 sm:py-24">
    <div class="mx-auto max-w-5xl">
      <h1 class="max-w-3xl text-4xl font-semibold text-linnen sm:text-5xl">
        Zo loopt een traject
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-muted">
        Geen traject is hetzelfde, maar de volgorde wel. Eerst begrijpen wat
        er gebeurt, dan ontwerpen, dan pas bouwen. Je weet van tevoren wat er
        van je verwacht wordt en wat er aan het eind van elke stap ligt.
      </p>
    </div>
  </section>

  <Sectie id="stappen" vlak>
    <ol>
      {
        processtappen.map((stap, i) => (
          <Processtap stap={stap} laatste={i === processtappen.length - 1} />
        ))
      }
    </ol>
  </Sectie>

  <Sectie id="werkwijze" kop="Hoe ik werk">
    <div class="mt-10 grid max-w-4xl gap-8 sm:grid-cols-2">
      <div>
        <h3 class="text-lg font-semibold text-linnen">Eenvoud voorop</h3>
        <p class="mt-2 text-muted">
          De simpelste oplossing die werkt, wint. Slim bouwen mag, maar alleen
          waar het iets oplevert. Een constructie die niemand behalve ik
          begrijpt is geen oplossing maar een nieuw probleem.
        </p>
      </div>
      <div>
        <h3 class="text-lg font-semibold text-linnen">Eén aanspreekpunt</h3>
        <p class="mt-2 text-muted">
          Je praat met de persoon die het ook bouwt. Geen accountmanager
          ertussen, geen overdracht aan een team dat het gesprek niet heeft
          gevoerd.
        </p>
      </div>
      <div>
        <h3 class="text-lg font-semibold text-linnen">Het team telt mee</h3>
        <p class="mt-2 text-muted">
          Een systeem dat niemand gebruikt is weggegooid geld. Daarom spreek
          ik de mensen die ermee werken, en hoort training bij het werk in
          plaats van erna.
        </p>
      </div>
      <div>
        <h3 class="text-lg font-semibold text-linnen">Klein beginnen</h3>
        <p class="mt-2 text-muted">
          Liever iets dat volgende maand werkt dan een plan dat over een jaar
          af is. We pakken eerst wat het meeste oplevert en bouwen van daaruit
          verder.
        </p>
      </div>
    </div>
  </Sectie>

  <Sectie id="plannen" vlak>
    <div class="max-w-2xl">
      <h2 class="text-3xl font-semibold text-linnen sm:text-4xl">
        Benieuwd hoe dit voor jou zou lopen?
      </h2>
      <p class="mt-4 text-lg text-muted">
        Stap één is een gesprek van 30 minuten. Daarna weet je of het zin
        heeft om verder te praten.
      </p>
      <div class="mt-8">
        <Knop toonToelichting />
      </div>
    </div>
  </Sectie>
</Basis>
