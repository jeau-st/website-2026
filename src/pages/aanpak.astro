---
import Basis from "../layouts/Basis.astro";
import Sectie from "../components/Sectie.astro";
import MetOpgave from "../components/MetOpgave.astro";
import Kaart from "../components/Kaart.astro";
import Knop from "../components/Knop.astro";
import Denkstap from "../components/Denkstap.astro";
import Cyclus from "../components/Cyclus.astro";
import Niveau from "../components/Niveau.astro";
import Stappentabel from "../components/Stappentabel.astro";
import Nastap from "../components/Nastap.astro";
import Vraag from "../components/Vraag.astro";
import { denkwijze, nabouw, niveaus, vragen } from "../data/site";

/**
 * De vragen stonden op de homepage. Ze gaan bijna allemaal over hoe een
 * traject loopt, dus ze horen hier, bij de stappen en bij het ritme na de
 * oplevering. Het FAQPage-schema verhuist mee: dat hoort op de pagina waar
 * het antwoord staat.
 *
 * Alleen vrijgegeven vragen in het schema: een TODO als antwoord aanbieden
 * aan Google is erger dan de vraag weglaten.
 */
/**
 * De secties van deze pagina, met de tekst die in de inhoudsopgave komt.
 * Een lijst, gebruikt voor allebei: de kop van de sectie en de regel in
 * de opgave. Zo kunnen ze niet uit elkaar lopen. De afspraak onderaan
 * staat er niet in, want een inhoudsopgave wijst naar inhoud.
 */
const delen = {
  volgorde: "De vier stappen",
  niveaus: "Waar sta jij?",
  stappen: "Zo loopt een opdracht",
  daarna: "En dan gaat het pas werken",
  werkwijze: "Hoe ik werk",
  vragen: "Veelgestelde vragen",
};

const opgave = Object.entries(delen).map(([id, tekst]) => ({ id, tekst }));

const faqSchema = {
  "@type": "FAQPage",
  mainEntity: vragen
    .filter((item) => !item.todo)
    .map((item) => ({
      "@type": "Question",
      name: item.vraag,
      acceptedAnswer: { "@type": "Answer", text: item.antwoord },
    })),
};
---

<Basis
  titel="Aanpak: eerst het proces, dan automatiseren | Jeau.st"
  beschrijving="Eerst het proces vastleggen en standaardiseren, dan automatiseren waar de meeste tijd in gaat zitten, dan meetbaar maken. En dan opnieuw."
  extraSchema={faqSchema}
>
  <section class="px-4 py-20 sm:px-6 sm:py-24">
    <div class="mx-auto max-w-5xl">
      <h1 class="max-w-3xl text-4xl sm:text-5xl">
        Eerst het proces, dan de techniek
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-zacht">
        Automatiseren is niet moeilijk. Het moeilijke is weten wat je moet
        automatiseren. Daarom gaat het bij mij altijd in dezelfde vier stappen,
        en is de laatste stap om terug te gaan naar de eerste.
      </p>
    </div>
  </section>

  <MetOpgave items={opgave}>
  <Sectie id="volgorde" vol kop={delen.volgorde}>
    <ol class="space-y-4">
      {denkwijze.map((stap) => <Denkstap stap={stap} />)}
    </ol>
    <Cyclus />
  </Sectie>

  <Sectie
    id="niveaus"
    vol
    kop={delen.niveaus}
    intro="Niet iedereen begint bij 01. Lees deze vier door en kijk welke het meest op jouw bedrijf lijkt."
  >
    <ol class="mt-12 space-y-4">
      {niveaus.map((niveau) => <Niveau niveau={niveau} />)}
    </ol>
    <p class="max-w-2xl border-t border-rand/60 pt-8 text-zacht">
      Zit je ertussenin, dan is dat normaal. Verkoop staat vaak op een ander
      niveau dan de administratie.
    </p>
  </Sectie>

  <Sectie
    id="stappen"
    vol
    kop={delen.stappen}
    intro="De vier stappen hierboven zijn de denkwijze. Hieronder staat hoe dat in de praktijk verloopt, met per stap wat ik doe, wat jij doet en wat er aan het eind ligt."
  >
    <Stappentabel />
  </Sectie>

  <Sectie
    id="daarna"
    vol
    kop={delen.daarna}
    intro="De oplevering is het begin. Dit is het ritme daarna."
  >
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {nabouw.map((stap) => <Nastap stap={stap} />)}
    </div>
    <p class="mt-10">
      <a
        class="tekstlink inline-flex min-h-11 items-center text-tekst"
        href="/diensten/ondersteuning-en-training/"
      >
        Lees wat ondersteuning en training inhoudt
      </a>
    </p>
  </Sectie>

  {/* Dit stond als raster van vier gelijke blokjes. Zo gelijk van vorm en
      lengte leest het als een sjabloon, dus nu een lijst met blokken die
      net zo lang zijn als ze hoeven te zijn. */}
  <Sectie id="werkwijze" vol kop={delen.werkwijze}>
    <div class="mt-12 max-w-2xl space-y-4">
      <Kaart>
        <h3 class="text-lg">
          Als niemand behalve ik het begrijpt, is het te slim gebouwd
        </h3>
        <p class="mt-2 text-zacht">
          De simpelste versie die werkt, wint. Slim bouwen mag, maar alleen
          waar het echt iets scheelt. Want een constructie die alleen ik kan
          onderhouden, maakt je afhankelijk van mij. Dat wil je niet en ik ook
          niet.
        </p>
      </Kaart>
      <Kaart>
        <h3 class="text-lg">Je praat met de persoon die het bouwt</h3>
        <p class="mt-2 text-zacht">
          Dezelfde persoon zit aan tafel bij het eerste gesprek en bij de
          oplevering.
        </p>
      </Kaart>
      <Kaart>
        <h3 class="text-lg">Het team beslist of het werkt</h3>
        <p class="mt-2 text-zacht">
          Een systeem dat niemand gebruikt, is weggegooid geld. Daarom spreek
          ik de mensen die ermee gaan werken al tijdens de analyse, en hoort
          training bij het werk in plaats van erna.
        </p>
      </Kaart>
      <Kaart>
        <h3 class="text-lg">Liever volgende maand iets dat werkt</h3>
        <p class="mt-2 text-zacht">
          Dan een plan dat over een jaar af is.
        </p>
      </Kaart>
    </div>
  </Sectie>

  <Sectie id="vragen" vol kop={delen.vragen}>
    <div class="mt-10 max-w-3xl space-y-3">
      {vragen.map((item) => <Vraag item={item} />)}
    </div>
  </Sectie>

  </MetOpgave>

  <Sectie id="plannen">
    <div class="max-w-2xl">
      <h2 class="text-3xl sm:text-4xl">
        Waar jouw rondje begint, weet ik nog niet
      </h2>
      <p class="mt-4 text-lg text-zacht">
        Dat hoor ik in een gesprek van 30 minuten. Daarna weet je of het zin
        heeft om verder te praten.
      </p>
      <div class="mt-8">
        <Knop toonToelichting />
      </div>
    </div>
  </Sectie>
</Basis>
