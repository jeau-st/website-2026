# Keystatic in GitHub-modus. Alleen nodig om op de live site te kunnen
# opslaan; lokaal draai je `npm run cms` en schrijft Keystatic gewoon in
# src/inhoud. Zie docs/keystatic.md voor hoe je aan de waarden komt.
#
# Kopieer dit bestand naar .env.local en vul het in. .env.local staat in
# .gitignore en hoort daar te blijven.

# Komt uit de GitHub App die /keystatic/setup voor je aanmaakt.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=

# Zelf verzinnen, een lange willekeurige reeks. Hiermee ondertekent
# Keystatic het sessiecookie. Maak er een met:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KEYSTATIC_SECRET=

# De naam van de app in de URL, dus het laatste stuk van
# https://github.com/apps/<dit-stuk>. Deze wordt in de pagina gebakken
# en is niet geheim, maar hij moet bij de build al bekend zijn.
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
